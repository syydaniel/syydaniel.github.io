---
import '../styles/global.css';
import '../styles/liquid-glass.css';
import '../styles/kinetics.css';
import Atmosphere from '../components/Atmosphere.astro';
import Intro from '../components/Intro.astro';
import GlassEffects from '../components/GlassEffects.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Arcade from '../components/Arcade.astro';
import FilmPlayer from '../components/FilmPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL to the social share image. */
  image?: string;
  /** 'website' (default) or 'article' for journal posts. */
  type?: 'website' | 'article';
  /** ISO date, emitted as article:published_time when type is 'article'. */
  publishedTime?: string;
  /** Keep this page out of search engines (e.g. drafts). */
  noindex?: boolean;
}

const {
  title = 'Yiyang Shen · MSc & Photographer',
  description = 'Personal site of Yiyang Shen (Daniel, 沈亦旸). MSc in Urban Environmental Management from Wageningen University & Research (2026), looking for a PhD in environmental modelling: soils, agriculture, greenhouse gases and water. Photographs and short films from the places I study.',
  image = '/og-image.jpg',
  type = 'website',
  publishedTime,
  noindex = false
} = Astro.props;

const site = Astro.site ?? new URL('https://syydaniel.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yiyang Shen',
  alternateName: ['Daniel', '沈亦旸'],
  url: site.href,
  image: ogImage,
  jobTitle: 'MSc, Urban Environmental Management',
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Wageningen University & Research' }],
  knowsAbout: ['Environmental modelling', 'Water systems', 'Microplastics', 'Soil ecosystem services', 'Agricultural greenhouse gas emissions', 'Machine learning', 'Photography', 'Filmmaking'],
  sameAs: [
    'https://www.linkedin.com/in/yiyang-shen-%E6%B2%88%E4%BA%A6%E6%97%B8-05502821b/',
    'https://github.com/syydaniel',
    'https://space.bilibili.com/437321627'
  ]
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Yiyang Shen',
  url: site.href
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05060a" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Yiyang Shen" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta property="og:locale:alternate" content="zh_TW" />
    <meta property="og:locale:alternate" content="nl_NL" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:locale:alternate" content="fi_FI" />
    <meta property="og:locale:alternate" content="ja_JP" />
    <meta property="og:locale:alternate" content="ko_KR" />
    <meta property="og:locale:alternate" content="fr_FR" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,100..900,0..100,0..1;1,9..144,100..900,0..100,0..1&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Only the glyphs we set in display sizes (the name, the seal, chapter numerals): a few kilobytes of Noto Serif SC. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@300;500&text=%E6%B2%88%E4%BA%A6%E6%97%B8%E5%8D%B0%E5%A3%B9%E8%B4%B0%E5%8F%81%E8%82%86%E4%BC%8D%E9%99%86%E6%9F%92%E6%8D%8C%E7%8E%96&display=swap"
      rel="stylesheet"
    />
    <!-- Decide before first paint whether the cinematic intro plays (once per session). -->
    <script is:inline>
      (function () {
        var seen = false;
        try { seen = !!sessionStorage.getItem('intro-seen'); } catch (e) {}
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.dataset.intro = seen || still ? 'done' : 'pending';
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </head>
  <body class="ambient-noise min-h-screen">
    <Intro />
    <GlassEffects />
    <Atmosphere />
    <div class="aurora" aria-hidden="true"></div>
    <div id="spotlight" aria-hidden="true"></div>
    <canvas id="ink-trail" aria-hidden="true"></canvas>
    <a href="#main-content" class="skip-link" data-i18n="nav.skip">Skip to content</a>
    <div id="reading-progress" aria-hidden="true"></div>
    <Nav />
    <main id="main-content" class="relative z-10" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Arcade />
    <FilmPlayer />

    <script>
      import '../scripts/i18n-runtime';

      import '../scripts/site-interactions';
      import '../scripts/liquid-motion';
      import '../scripts/kinetics';
    </script>
  </body>
</html>
