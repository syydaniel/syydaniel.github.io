---
import '../styles/fonts.css';
import '../styles/theme.css';
import '../styles/global.css';
import '../styles/liquid-glass.css';
import '../styles/kinetics.css';
import Atmosphere from '../components/Atmosphere.astro';
import Intro from '../components/Intro.astro';
import GlassEffects from '../components/GlassEffects.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Arcade from '../components/Arcade.astro';
import FilmPlayer from '../components/FilmPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL to the social share image. */
  image?: string;
  /** 'website' (default) or 'article' for journal posts. */
  type?: 'website' | 'article';
  /** ISO date, emitted as article:published_time when type is 'article'. */
  publishedTime?: string;
  /** Keep this page out of search engines (e.g. drafts). */
  noindex?: boolean;
}

const {
  title = 'Yiyang Shen · MSc & Photographer',
  description = 'Yiyang Shen (Daniel, 沈亦旸). MSc in Urban Environmental Management, Wageningen University & Research, 2026. Looking for a PhD in environmental modelling: soil, farming, greenhouse gases and water. Photographs and short films from the places I work in.',
  image = '/og-image.jpg',
  type = 'website',
  publishedTime,
  noindex = false
} = Astro.props;

const site = Astro.site ?? new URL('https://syydaniel.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yiyang Shen',
  alternateName: ['Daniel', '沈亦旸'],
  url: site.href,
  image: ogImage,
  jobTitle: 'MSc, Urban Environmental Management',
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Wageningen University & Research' }],
  knowsAbout: ['Environmental modelling', 'Water systems', 'Microplastics', 'Soil ecosystem services', 'Agricultural greenhouse gas emissions', 'Machine learning', 'Photography', 'Filmmaking'],
  sameAs: [
    'https://www.linkedin.com/in/yiyang-shen-%E6%B2%88%E4%BA%A6%E6%97%B8-05502821b/',
    'https://github.com/syydaniel',
    'https://space.bilibili.com/437321627'
  ]
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Yiyang Shen',
  url: site.href
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3efe6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121516" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Yiyang Shen" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta property="og:locale:alternate" content="zh_TW" />
    <meta property="og:locale:alternate" content="nl_NL" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:locale:alternate" content="fi_FI" />
    <meta property="og:locale:alternate" content="ja_JP" />
    <meta property="og:locale:alternate" content="ko_KR" />
    <meta property="og:locale:alternate" content="fr_FR" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Fonts are served from this origin (scripts/fetch-fonts.mjs). The Chinese interface adds Noto Serif SC from Google Fonts on demand. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/fraunces-normal-100-900-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/fraunces-italic-100-900-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/instrument-sans-normal-400-700-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/noto-serif-sc-display-normal-200-900.woff2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Decide before first paint which ink the page wears (the reader's device decides, or a pin, which lasts until their sky next changes) and whether the Sun is up where they are (after dark the day ink is lamp-lit), and whether the opening plays (once per session). -->
    <script is:inline>
      (function () {
        var up = true;
        var params = new URLSearchParams(location.search);
        try {
          var forced = params.get('sky');
          if (forced) up = forced !== 'night';
          else {
            // The reader's own sky, near enough: the longitude from the clock's offset, a temperate latitude for the hemisphere.
            var zone = ''; try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
            var here = zone === 'Europe/Amsterdam';
            var lon = here ? 5.66 : -new Date().getTimezoneOffset() / 4;
            var latDeg = here ? 51.97 : (/^(Australia|Antarctica|Pacific\/(Auckland|Chatham|Fiji|Tongatapu|Apia|Noumea|Port_Moresby)|Africa\/(Johannesburg|Windhoek|Maputo|Harare|Lusaka|Gaborone|Maseru|Mbabane|Luanda)|America\/(Sao_Paulo|Argentina|Buenos_Aires|Santiago|Montevideo|Asuncion|La_Paz|Lima)|Indian\/(Mauritius|Reunion))/.test(zone) ? -35 : 42);
            var d = Date.now() / 864e5 - 10957.5, r = Math.PI / 180;
            var L = (280.46 + 0.9856474 * d) % 360, g = ((357.528 + 0.9856003 * d) % 360) * r;
            var lam = (L + 1.915 * Math.sin(g) + 0.02 * Math.sin(2 * g)) * r, eps = (23.439 - 4e-7 * d) * r;
            var ra = Math.atan2(Math.cos(eps) * Math.sin(lam), Math.cos(lam)), dec = Math.asin(Math.sin(eps) * Math.sin(lam));
            var gmst = ((18.697374558 + 24.06570982441908 * d) % 24 + 24) % 24, h = (gmst * 15 + lon) * r - ra, lat = latDeg * r;
            up = Math.asin(Math.sin(lat) * Math.sin(dec) + Math.cos(lat) * Math.cos(dec) * Math.cos(h)) / r > -1.2;
          }
        } catch (e) {}
        var theme = null;
        try {
          theme = localStorage.getItem('theme');
          var until = localStorage.getItem('theme-until');
          if (theme && until && until !== (up ? 'day' : 'night')) { localStorage.removeItem('theme'); localStorage.removeItem('theme-until'); theme = null; }
        } catch (e) {}
        var ink = params.get('ink');
        if (ink === 'light' || ink === 'dark') theme = ink;
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        if (!up && theme === 'light') document.documentElement.dataset.lamp = '';
        var seen = false;
        try { seen = !!sessionStorage.getItem('intro-seen'); } catch (e) {}
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.dataset.intro = seen || still ? 'done' : 'pending';
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </head>
  <body class="ambient-noise min-h-screen">
    <Intro />
    <GlassEffects />
    <Atmosphere />
    <div class="aurora" aria-hidden="true"></div>
    <div class="skylight" aria-hidden="true"></div>
    <div id="spotlight" aria-hidden="true"></div>
    <canvas id="ink-trail" aria-hidden="true"></canvas>
    <div id="cursor-badge" aria-hidden="true"><span></span></div>
    <a href="#main-content" class="skip-link" data-i18n="nav.skip">Skip to content</a>
    <Nav />
    <main id="main-content" class="relative z-10" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Arcade />
    <FilmPlayer />

    <script>
      import '../scripts/i18n-runtime';
      import '../scripts/theme';
      import '../scripts/sky';

      import '../scripts/site-interactions';
      import '../scripts/liquid-motion';
      import '../scripts/kinetics';
      import '../scripts/inertia';
    </script>
  </body>
</html>
