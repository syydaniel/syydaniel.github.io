---
import { profile } from '../data/profile';
import Seal from './Seal.astro';
import Catchment from './Catchment.astro';
import Ticker from './Ticker.astro';
---

<section id="hero" class="hero-section">
  <Catchment />
  <div class="hero-shell">
    <div class="hero-grid">
      <aside class="hero-signature" aria-hidden="true">
        <span class="signature-name">沈亦旸</span>
        <Seal size={48} class="signature-seal" />
        <span class="signature-meta">Daniel</span>
      </aside>
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="status-dot" aria-hidden="true"></span>
          <span data-i18n="hero.eyebrow">{profile.title}</span>
        </div>
        <h1 class="hero-title">
          <span class="hero-line"><span class="hero-word">Yiyang</span></span>
          <span class="hero-line hero-surname"><span class="hero-word">Shen</span></span>
        </h1>
        <p class="hero-alias-row"><span>沈亦旸</span><i aria-hidden="true">/</i><span>Daniel</span><Seal size={34} class="hero-seal" /></p>
        <p class="hero-tagline">
          <span data-i18n="hero.tagline.a">Environmental modelling, interested in soils, water and the climate of farmland. Photographing the</span>
          <span class="ink"><em data-i18n="hero.tagline.b">quiet light</em><svg class="ink-stroke" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8 C 40 2, 80 11, 120 6 S 175 3, 198 8" pathLength="100" /></svg></span>
          <span data-i18n="hero.tagline.c">that falls on all three.</span>
        </p>
        <div class="hero-actions">
          <a href="#journey" class="btn btn-primary">
            <span data-i18n="hero.cta.primary">Explore the work</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
          <a href="#photography" class="btn btn-ghost">
            <span data-i18n="hero.cta.secondary">Photography</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="hero-foot">
      <p class="hero-hint"><i aria-hidden="true"></i><span data-i18n="hero.hint">Move to rain on the model · Hold for a downpour · Water finds the valley</span></p>
      <a href="#about" class="hero-scroll"><span data-i18n="hero.scroll">Scroll</span><span class="scroll-line" aria-hidden="true"><i></i></span><span aria-hidden="true">↓</span></a>
    </div>
  </div>
  <Ticker />
</section>

<style>
  .hero-section { position: relative; overflow: hidden; min-height: 100svh; display: flex; flex-direction: column; }
  .hero-shell { position: relative; z-index: 2; flex: 1; display: flex; flex-direction: column; width: 100%; max-width: 1280px; margin: 0 auto; padding: 150px 48px 28px; }
  .hero-grid { flex: 1; display: grid; grid-template-columns: 56px minmax(0, 660px); align-items: start; gap: 40px 48px; }
  .hero-copy { min-width: 0; animation: hero-arrive 900ms cubic-bezier(.22,1,.36,1) both; }
  @keyframes hero-arrive { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .hero-eyebrow { display: flex; align-items: center; gap: .75rem; color: var(--ink-3); font-size: 10px; letter-spacing: .2em; font-family: 'JetBrains Mono', ui-monospace, monospace; text-transform: uppercase; line-height: 1.8; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--zhusha); box-shadow: 0 0 0 4px color-mix(in srgb, var(--zhusha) 14%, transparent); flex-shrink: 0; animation: status-breathe 3.2s ease-in-out infinite; }
  @keyframes status-breathe { 0%, 100% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--zhusha) 16%, transparent); } 50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--zhusha) 6%, transparent); } }
  .hero-title { font-family: 'Fraunces', Georgia, serif; font-weight: 300; font-optical-sizing: auto; font-variation-settings: 'opsz' 144, 'SOFT' 40, 'WONK' 1; font-size: clamp(5rem, 10.4vw, 9.6rem); line-height: .96; letter-spacing: -.055em; color: var(--ink); margin-top: 30px; }
  .hero-line { display: block; }
  .hero-surname { font-style: italic; color: var(--daiqing); font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; }
  .hero-alias-row { display: none; align-items: center; gap: 14px; margin-top: 20px; font-family: 'Noto Serif SC', 'Songti SC', serif; font-size: 13px; letter-spacing: .22em; color: var(--ink-3); }
  .hero-alias-row i { font-style: normal; color: var(--ink-5); }
  .hero-tagline { font-family: 'Fraunces', Georgia, serif; font-variation-settings: 'opsz' 32, 'SOFT' 60; margin-top: 34px; font-size: 23px; line-height: 1.45; color: var(--ink-2); max-width: 560px; font-weight: 300; text-wrap: balance; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .hero-actions .btn { font-size: 13px; padding: 14px 24px; gap: 1rem; }
  .hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 28px; }
  .hero-hint { display: inline-flex; align-items: center; gap: 12px; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-4); }
  .hero-hint i { width: 26px; height: 1px; background: var(--zhusha); flex-shrink: 0; }
  .hero-scroll { display: flex; align-items: center; gap: 18px; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-4); }
  .scroll-line { position: relative; width: 55px; height: 1px; background: var(--line-strong); overflow: visible; }
  /* A drop runs the cue every few seconds: the rain motif, pointing down the page. */
  .scroll-line i { position: absolute; left: 0; top: -2px; width: 5px; height: 5px; border-radius: 50%; background: var(--daiqing); opacity: 0; animation: cue-drop 4.2s cubic-bezier(0.45, 0, 0.3, 1) 2s infinite; }
  @keyframes cue-drop { 0% { left: 0; opacity: 0; transform: scale(0.6); } 8% { opacity: 1; transform: scale(1); } 42% { left: calc(100% - 5px); opacity: 1; transform: scale(1); } 52% { left: calc(100% - 5px); opacity: 0; transform: scale(0.4); } 100% { left: calc(100% - 5px); opacity: 0; } }
  @media (min-width: 1600px) { .hero-shell { padding-top: max(170px, calc((100svh - 620px) / 2)); } }
  @media (max-width: 1100px) { .hero-shell { padding-inline: 32px; } .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 28px; } .hero-alias-row { display: inline-flex; } .hero-title { font-size: 100px; } }
  @media (max-width: 767px) {
    .hero-shell { padding: 118px 24px 22px; }
    .hero-title { font-size: clamp(78px, 17vw, 112px); }
    .hero-alias-row { font-size: 11px; gap: 10px; margin-top: 16px; }
    .hero-eyebrow { font-size: 9px; letter-spacing: .12em; }
    .hero-tagline { font-size: 21px; margin-top: 26px; }
    .hero-actions .btn { font-size: 11px; padding: 13px 16px; gap: 12px; }
    .hero-hint { display: none; }
    .hero-foot { margin-top: 36px; }
    .hero-scroll { gap: 10px; } .scroll-line { display: none; }
  }
  @media (max-width: 359px) { .hero-title { font-size: 72px; } }
</style>
