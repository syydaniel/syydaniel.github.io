---
import { profile } from '../data/profile';
import { films } from '../data/films';
import ParticleScene from './ParticleScene.astro';
import Globe from './Globe.astro';
const latest = films.find(film => film.featured);
const statKeys = ['stat.countries', 'stat.universities', 'stat.projects', 'stat.photos'];
---

<section id="hero" class="hero-section">
  <div class="hero-topography" aria-hidden="true"></div>
  <div class="hero-shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="status-dot" aria-hidden="true"></span>
          <span data-i18n="hero.eyebrow">MSc, Wageningen · Open to PhD positions · Photographer</span>
        </div>
        <h1 class="hero-title">
          <span>Yiyang</span>
          <span class="hero-surname">Shen<span class="hero-alias">沈亦旸 <i aria-hidden="true">/</i> Daniel</span></span>
        </h1>
        <p class="hero-tagline" data-i18n="hero.tagline">{profile.tagline}</p>
        <p class="hero-description" data-i18n="hero.subtitle">{profile.subtitle}</p>
        <div class="hero-actions">
          <a href="#journey" class="btn btn-primary">
            <span data-i18n="hero.cta.primary">Explore journey</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
          <a href="#photography" class="btn btn-ghost">
            <span data-i18n="hero.cta.secondary">Photography map</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        </div>
        <div class="hero-documents">
          <a href="/Yiyang_Shen_CV_2026.pdf" target="_blank" rel="noopener" class="hero-document glass liquid-glass card-hover">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h5"/></svg>
            <span><strong data-i18n="hero.docs.cv.label">Curriculum Vitae</strong><small data-i18n="hero.docs.cv.meta">PDF · Updated Sep 2026</small></span>
            <span class="document-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/Yiyang_Shen_Transcript.pdf" target="_blank" rel="noopener" class="hero-document glass liquid-glass card-hover">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
            <span><strong data-i18n="hero.docs.transcript.label">Academic Transcript</strong><small data-i18n="hero.docs.transcript.meta">PDF · WUR record · May 2026</small></span>
            <span class="document-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="hero-art">
        <div class="hero-orbit">
          <ParticleScene ambient />
          <div class="hero-globe"><Globe /></div>
        </div>
        {latest?.featured && (
          <button type="button" class="hero-film glass liquid-glass card-hover group" data-film={latest.bvid} aria-label={`Play: ${latest.title.en}`}>
            <span class="hero-film-frame"><img src={latest.featured.stillSm} alt="" width="84" height="62" loading="lazy" decoding="async" class="media-img" /><span class="hero-film-play" aria-hidden="true">▶</span></span>
            <span class="hero-film-copy"><span class="hero-film-label" data-i18n="about.now_showing">Now showing</span><span class="hero-film-title" data-i18n-self={JSON.stringify(latest.title)}>{latest.title.en}</span></span>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </button>
        )}
      </div>
    </div>
    <div class="hero-footer">
      <div class="hero-stats">
        {profile.stats.map((stat, i) => (
          <div class="hero-stat"><span>{stat.value}</span><small data-i18n={statKeys[i]}>{stat.label}</small></div>
        ))}
      </div>
      <a href="#about" class="hero-scroll"><span data-i18n="hero.scroll">Scroll</span><span class="scroll-line" aria-hidden="true"></span><span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  .hero-section { position: relative; overflow: hidden; min-height: 100svh; }
  .hero-topography { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 75% 42%, #91c9b50d 0%, transparent 55%); }
  .hero-topography::after { content: ''; position: absolute; width: 650px; height: 650px; top: 12%; right: -300px; border: 1px solid #c9dfcd06; border-radius: 50%; box-shadow: 0 0 0 70px #c9dfcd03, 0 0 0 140px #c9dfcd02; }
  .hero-shell { max-width: 1280px; margin: 0 auto; padding: 145px 48px 40px; position: relative; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: 56px; }
  .hero-copy { min-width: 0; animation: hero-arrive 900ms cubic-bezier(.22,1,.36,1) both; }
  @keyframes hero-arrive { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .hero-eyebrow { display: flex; align-items: center; gap: .75rem; color: #a8c5b5; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; line-height: 1.8; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #b7dab6; box-shadow: 0 0 0 4px #b7dab60d; flex-shrink: 0; }
  .hero-title { font-family: 'Fraunces', Georgia, serif; font-weight: 300; font-size: clamp(5rem, 8.7vw, 8rem); line-height: .95; letter-spacing: -.065em; color: #f0f3e9; margin-top: 30px; }
  .hero-title > span { display: block; }
  .hero-surname { font-style: italic; color: #c3dbc7; }
  .hero-alias { display: inline-block; font-family: 'Inter', sans-serif; font-size: 11px; font-style: normal; letter-spacing: .12em; color: #9caf9f; margin-left: 24px; vertical-align: middle; white-space: nowrap; }
  .hero-alias i { padding: 0 .45rem; color: #5a7266; font-style: normal; }
  .hero-tagline { font-family: 'Fraunces', Georgia, serif; margin-top: 32px; font-size: 21px; line-height: 1.5; color: #d4dfd6; max-width: 465px; font-weight: 300; }
  .hero-description { margin-top: 16px; max-width: 460px; font-size: 12px; line-height: 1.9; color: #a2b1aa; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero-actions .btn { font-size: 12px; padding: 14px 22px; gap: 1rem; }
  .hero-documents { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 28px; max-width: 510px; }
  .hero-document { display: flex; align-items: center; gap: 12px; padding: 16px; border-radius: 16px; color: #b6cbbb; }
  .hero-document > svg { flex-shrink: 0; }
  .hero-document > span { min-width: 0; }
  .hero-document strong { display: block; font-size: 10px; font-weight: 500; color: #d8e5da; }
  .hero-document small { display: block; margin-top: 5px; font-size: 8px; line-height: 1.6; color: #9cab9f; }
  .hero-document .document-arrow { margin-left: auto; color: #9ab9a7; font-size: 15px; flex-shrink: 0; }
  .hero-art { position: relative; min-width: 0; padding-top: 20px; }
  .hero-orbit { position: relative; padding: 28px 0 110px; }
  .hero-globe { position: relative; z-index: 2; }
  .hero-film { display: flex; align-items: center; text-align: left; gap: 16px; border-radius: 18px; padding: 9px 16px 9px 9px; width: min(100%, 330px); margin: 28px 0 0 auto; }
  .hero-film-frame { position: relative; width: 76px; height: 56px; border-radius: 10px; overflow: hidden; flex-shrink: 0; }
  .hero-film-frame img { width: 100%; height: 100%; object-fit: cover; }
  .hero-film-play { position: absolute; inset: 0; display: grid; place-items: center; color: white; background: #00000026; font-size: 10px; }
  .hero-film-copy { flex: 1; min-width: 0; }
  .hero-film-label { display: block; font-family: 'JetBrains Mono', monospace; font-size: 8px; letter-spacing: .16em; text-transform: uppercase; color: #a7bcad; }
  .hero-film-title { display: block; font-family: 'Fraunces', Georgia, serif; font-size: 14px; color: #dce5d9; line-height: 1.3; margin-top: 5px; }
  .hero-film > svg { color: #aecab6; flex-shrink: 0; }
  .hero-footer { margin-top: 44px; padding-top: 24px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #d9e8d412; }
  .hero-stats { display: flex; gap: 40px; }
  .hero-stat { display: flex; align-items: center; gap: 12px; }
  .hero-stat > span { font-family: 'Fraunces', Georgia, serif; font-size: 28px; font-weight: 300; color: #d6e5d3; }
  .hero-stat small { max-width: 90px; font-size: 8px; color: #94a59b; line-height: 1.7; letter-spacing: .1em; text-transform: uppercase; }
  .hero-scroll { display: flex; align-items: center; gap: 18px; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .13em; text-transform: uppercase; color: #a1b1a5; }
  .scroll-line { width: 55px; height: 1px; background: #99b6a538; }
  @media (min-width: 1600px) { .hero-shell { padding-top: max(160px, calc((100svh - 650px) / 2)); } }
  @media (max-width: 1100px) { .hero-shell { padding-inline: 32px; } .hero-grid { gap: 28px; } .hero-alias { display: block; margin: 18px 0 0 4px; } .hero-title { font-size: 100px; } }
  @media (max-width: 767px) {
    .hero-shell { padding: 120px 24px 32px; }
    .hero-grid { grid-template-columns: 1fr; gap: 50px; }
    .hero-title { font-size: clamp(85px, 18vw, 120px); }
    .hero-alias { display: inline-block; margin: 0 0 0 20px; font-size: 10px; }
    .hero-eyebrow { font-size: 8px; letter-spacing: .09em; }
    .hero-tagline { font-size: 21px; margin-top: 26px; }
    .hero-description { font-size: 12px; }
    .hero-actions .btn { font-size: 11px; padding: 13px 16px; gap: 12px; }
    .hero-art { max-width: 510px; width: 100%; margin: 0 auto; padding-top: 0; }
    .hero-orbit { position: relative; padding: 28px 0 110px; }
  .hero-globe { position: relative; z-index: 2; }
  .hero-film { margin: 25px auto 0; }
    .hero-footer { margin-top: 40px; }
    .hero-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px 35px; }
    .hero-scroll { gap: 10px; } .scroll-line { display: none; }
    .hero-document { padding: 13px 10px; gap: 8px; }
    .hero-document strong { font-size: 9px; } .hero-document small { font-size: 8px; }
  }
  @media (max-width: 359px) { .hero-title { font-size: 80px; } .hero-alias { margin-left: 14px; font-size: 8px; } .hero-documents { grid-template-columns: 1fr; } }
</style>
