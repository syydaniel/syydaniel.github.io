---
import LangSwitcher from './LangSwitcher.astro';
import Seal from './Seal.astro';

const links: { href: string; target?: string; label: string; i18n: string }[] = [
  { href: '/#hero', target: '#hero', label: 'Home', i18n: 'nav.home' },
  { href: '/#about', target: '#about', label: 'About', i18n: 'nav.about' },
  { href: '/#journey', target: '#journey', label: 'Journey', i18n: 'nav.journey' },
  { href: '/#places', target: '#places', label: 'Places', i18n: 'nav.places' },
  { href: '/#photography', target: '#photography', label: 'Photography', i18n: 'nav.photography' },
  { href: '/#films', target: '#films', label: 'Films', i18n: 'nav.films' },
  { href: '/#nyalang', target: '#nyalang', label: 'Nya', i18n: 'nav.nyalang' },
  { href: '/#contact', target: '#contact', label: 'Contact', i18n: 'nav.contact' }
];
---

<header
  id="site-nav"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-500"
>
  <div class="mx-auto max-w-[1280px] px-6 md:px-8 mt-5">
    <nav class="site-nav-panel glass liquid-glass rounded-2xl px-5 py-3 flex items-center justify-between gap-4" aria-label="Main navigation" data-refract>
      <a href="/" class="flex items-center gap-2 group">
        <Seal size={30} stamp={false} class="nav-seal" />
        <span class="font-display text-ink-100 text-[0.95rem] whitespace-nowrap hidden sm:inline" data-i18n="brand.name">Yiyang Shen</span>
      </a>

      <ul class="nav-track hidden xl:flex items-center gap-1">
        {
          // The full menu remains available on smaller screens.
          links.filter((link) => link.i18n !== 'nav.home').map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link whitespace-nowrap px-3 xl:px-3.5 py-2 rounded-xl text-xs text-ink-300 hover:text-ink-100 transition-colors"
                data-target={link.target}
                data-i18n={link.i18n}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-3">
        <LangSwitcher />
        <a
          href="/Yiyang_Shen_CV_2026.pdf"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost !py-2 !px-4 text-sm max-xl:!hidden gap-1.5"
          aria-label="Download CV (PDF)"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span data-i18n="nav.cv">CV</span>
        </a>
        <a
          href="mailto:syydaniel@gmail.com"
          class="btn btn-primary !py-2 !px-4 text-sm whitespace-nowrap max-xl:!hidden"
          data-i18n="nav.cta"
        >
          Let's talk
        </a>

        <button
          id="nav-toggle"
          type="button"
          aria-label="Navigation menu"
          data-i18n-attr='{"aria-label":"nav.menu"}'
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="xl:hidden p-2 rounded-full hover:bg-white/5 transition-colors"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M3 7h18M3 12h18M3 17h18" />
          </svg>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="xl:hidden hidden glass liquid-glass rounded-2xl mt-2 p-3">
      <ul class="flex flex-col gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block px-4 py-2.5 rounded-xl text-ink-200 hover:bg-white/5 transition-colors"
                data-i18n={link.i18n}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/Yiyang_Shen_CV_2026.pdf"
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl text-aqua-300 hover:bg-white/5 transition-colors"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span data-i18n="nav.cv">CV</span>
            <span class="text-xs text-ink-400 ml-auto">PDF</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  if (nav) {
    const update = () => {
      if (window.scrollY > 24) nav.classList.add('scrolled');
      else nav.classList.remove('scrolled');
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  function closeMenu() {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }
  toggle?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(hidden === false));
  });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      closeMenu();
      toggle?.focus();
    }
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !nav?.contains(event.target)) closeMenu();
  });
  matchMedia('(min-width: 1280px)').addEventListener('change', closeMenu);

  // Active section highlighting
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

  const sections = Array.from(navLinks)
    .map((a) => a.dataset.target)
    .filter((t): t is string => !!t)
    .map((t) => document.querySelector(t))
    .filter((el): el is HTMLElement => el instanceof HTMLElement);

  const activeObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => {
            const on = a.dataset.target === `#${entry.target.id}`;
            a.classList.toggle('text-ink-100', on);
            a.classList.toggle('bg-white/5', on);
            if (on) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          });
        }
      }
    },
    { rootMargin: '-40% 0px -50% 0px' }
  );
  sections.forEach((s) => activeObserver.observe(s));
</script>

<style>
  #mobile-menu { max-height: calc(100svh - 110px); overflow-y: auto; }
</style>
