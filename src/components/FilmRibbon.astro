---
// The latest film, announced in a small glass card in the corner of the page.
// It reads the newest film in src/data/films.ts, so it updates itself when a
// film is added. Pressing the card opens the film in the site-wide player
// (FilmPlayer.astro). While the reader is at the top of the page the card is
// open; once they scroll on into the chapters it folds into a small tab that
// keeps out of the way of the reading, and it steps aside while the film's own
// stage in the Films chapter is on screen. Folding it away or closing it is
// remembered per film (localStorage), so the next film is announced afresh.
import { films, coverThumb } from '../data/films';

const latest = [...films].sort((a, b) => (a.date < b.date ? 1 : -1))[0];
const still = latest.featured?.stillSm;
// A film without a still borrows its Bilibili cover, washed out like the posters.
const img = still ?? coverThumb(latest.cover, 320, 180);
const focus = latest.featured?.focus ?? '50% 50%';
const self = (v: unknown) => JSON.stringify(v);
---

<aside class="nf" id="nf" data-bvid={latest.bvid} data-state="off" aria-label="Latest film" data-i18n-attr={self({ 'aria-label': 'ribbon.latest' })}>
  <div class="nf-card liquid-glass" inert>
    <button type="button" class="nf-open group" data-film={latest.bvid} aria-label={`Play: ${latest.title.en}`}>
      <span class="nf-poster matted">
        <img src={img} alt="" decoding="async" class:list={['media-img', !still && 'nf-wash']} style={`object-position:${focus}`} referrerpolicy={still ? undefined : 'no-referrer'} />
        <span class="grain" aria-hidden="true"></span>
        <span class="nf-play play-dot" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg>
        </span>
      </span>
      <span class="nf-text">
        <span class="meta-line nf-meta"><span class="nf-new" data-i18n="ribbon.latest">Latest film</span></span>
        <span class="nf-title font-display italic" data-i18n-self={self(latest.title)}>{latest.title.en}</span>
        {latest.featured && <span class="nf-line" data-i18n-self={self(latest.featured.tagline)}>{latest.featured.tagline.en}</span>}
      </span>
    </button>
    <span class="nf-tools">
      <button type="button" class="nf-tool" data-nf="fold" aria-label="Fold away" title="Fold away" data-i18n-attr={self({ 'aria-label': 'ribbon.fold', title: 'ribbon.fold' })}>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <button type="button" class="nf-tool" data-nf="close" aria-label="Close" title="Close" data-i18n-attr={self({ 'aria-label': 'ribbon.close', title: 'ribbon.close' })}>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </span>
  </div>
  <button type="button" class="nf-tab liquid-glass" data-nf="unfold" aria-label="Show the latest film" data-i18n-attr={self({ 'aria-label': 'ribbon.unfold' })} inert>
    <span class="nf-tab-img">
      <img src={img} alt="" decoding="async" class:list={[!still && 'nf-wash']} style={`object-position:${focus}`} referrerpolicy={still ? undefined : 'no-referrer'} />
    </span>
    <span class="meta-line nf-tab-label"><span class="nf-new" data-i18n="ribbon.latest">Latest film</span></span>
    <span class="nf-tab-title font-display italic" data-i18n-self={self(latest.title)}>{latest.title.en}</span>
  </button>
</aside>

<style is:global>
  /* Rules that meet a shared class (.liquid-glass, .meta-line, .font-display,
     .play-dot) start at .nf, so they win in either stylesheet order (dev and
     production bundle the CSS differently). The card sits above the hero's
     instrument ticker, which runs along the foot of the first screen. */
  .nf { position: fixed; right: 24px; bottom: 3.25rem; z-index: 45; pointer-events: none; }
  .nf .nf-card,
  .nf .nf-tab {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(14px) scale(0.96);
    transform-origin: 100% 100%;
    transition: opacity 0.45s var(--ease-film), transform 0.7s var(--ease-film), visibility 0s linear 0.7s, border-color 0.4s, box-shadow 0.5s, background 0.4s;
  }
  .nf[data-state='card'] .nf-card,
  .nf[data-state='tab'] .nf-tab {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
    transition: opacity 0.45s var(--ease-film), transform 0.7s var(--ease-film), visibility 0s, border-color 0.4s, box-shadow 0.5s, background 0.4s;
  }
  /* The tab waits for the card to fold before it rises, and the other way round. */
  .nf[data-state='tab'] .nf-tab,
  .nf[data-state='card'] .nf-card { transition-delay: 0.12s, 0.12s, 0s, 0s, 0s, 0s; }

  /* ---- the card ---- */
  .nf .nf-card { position: relative; width: 21.5rem; border-radius: 14px; }
  .nf .nf-card:hover { border-color: color-mix(in srgb, var(--ink) 24%, transparent); }
  .nf-open { display: flex; align-items: stretch; gap: 0.9rem; width: 100%; padding: 0.55rem; text-align: left; border-radius: inherit; cursor: pointer; }
  .nf-open:focus-visible { outline-offset: 2px; }
  .nf-poster { position: relative; flex: none; width: 5.75rem; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 9px; background: var(--paper-3); box-shadow: 0 10px 24px -16px color-mix(in srgb, var(--shadow) 60%, transparent); }
  .nf-poster.matted::after { inset: 4px; border-radius: 6px; }
  .nf-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .nf-wash { filter: blur(10px) saturate(1.4) brightness(0.8) !important; transform: scale(1.4) !important; }
  .nf .nf-play { position: absolute; right: 6px; bottom: 6px; z-index: 2; width: 1.6rem; height: 1.6rem; background: color-mix(in srgb, var(--paper-hi) 62%, transparent); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
  .nf .nf-open:hover .nf-play,
  .nf .nf-open:focus-visible .nf-play { background: var(--zhusha); color: var(--on-seal); box-shadow: inset 0 0 0 1px var(--zhusha); }

  .nf-text { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: 0.15rem 0.2rem 0.15rem 0; }
  .nf-meta { padding-right: 3.6rem; }
  .nf-new { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--zhusha); }
  .nf-new::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; animation: nf-breathe 2.8s ease-in-out infinite; }
  @keyframes nf-breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .nf .nf-title { margin-top: 0.45rem; font-size: 1.22rem; line-height: 1.08; letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; transition: color 0.3s ease; }
  .nf .nf-open:hover .nf-title { color: var(--zhusha); }
  .nf-line { display: -webkit-box; margin-top: 0.4rem; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 4; font-size: 0.78rem; line-height: 1.45; color: var(--ink-3); }

  .nf-tools { position: absolute; top: 0.4rem; right: 0.4rem; z-index: 2; display: flex; gap: 0.1rem; }
  .nf-tool { display: inline-flex; width: 1.65rem; height: 1.65rem; align-items: center; justify-content: center; border-radius: 999px; color: var(--ink-4); transition: background 0.25s ease, color 0.25s ease, opacity 0.3s ease; }
  .nf-tool:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); }
  @media (hover: hover) and (pointer: fine) {
    .nf-tool { opacity: 0.55; }
    .nf-card:hover .nf-tool, .nf-card:focus-within .nf-tool { opacity: 1; }
  }

  /* ---- the tab ---- */
  .nf .nf-tab { position: absolute; right: 0; bottom: 0; display: inline-flex; align-items: center; gap: 0.6rem; max-width: calc(100vw - 24px); height: 2.75rem; padding: 0.3rem 1rem 0.3rem 0.3rem; border-radius: 999px; white-space: nowrap; cursor: pointer; }
  .nf .nf-tab:hover { border-color: color-mix(in srgb, var(--ink) 24%, transparent); }
  .nf-tab-img { position: relative; flex: none; width: 2.15rem; height: 2.15rem; overflow: hidden; border-radius: 50%; background: var(--paper-3); }
  .nf-tab-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-film); }
  .nf-tab:hover .nf-tab-img img { transform: scale(1.12); }
  .nf .nf-tab-label { flex: none; }
  .nf .nf-tab-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; font-size: 0.98rem; color: var(--ink); }

  /* 猫语: the cat-sigils follow the type size instead of their fixed 25px. */
  .nf .nya-cat { width: 1.3em !important; height: 1.3em !important; }

  /* Phones: the card spans the foot of the screen, and folds as soon as the reader scrolls. */
  @media (max-width: 639px) {
    .nf { right: 12px; left: 12px; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); display: flex; justify-content: flex-end; }
    .nf .nf-card { width: 100%; max-width: 25rem; }
    .nf-open { gap: 0.8rem; padding: 0.5rem; }
    .nf-poster { width: 4.75rem; }
    .nf .nf-title { font-size: 1.08rem; }
    .nf-line { -webkit-line-clamp: 3; }
    .nf-tool { width: 2rem; height: 2rem; }
    .nf-meta { padding-right: 4.4rem; }
    /* The tab keeps to the thumbnail and the title, the narrowest it can be. */
    .nf .nf-tab-label { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .nf-new::before { animation: none; } }
  @media print { .nf { display: none !important; } }
</style>

<script>
  const nf = document.getElementById('nf');
  const card = nf?.querySelector<HTMLElement>('.nf-card');
  const tab = nf?.querySelector<HTMLButtonElement>('.nf-tab');

  if (nf && card && tab) {
    const root = document.documentElement;
    const bvid = nf.dataset.bvid!;
    const KEY = 'latest-film';
    let saved = '';
    try { saved = localStorage.getItem(KEY) ?? ''; } catch {}
    const remember = (value: string | null) => {
      try { value ? localStorage.setItem(KEY, value) : localStorage.removeItem(KEY); } catch {}
    };

    if (saved === `${bvid}:closed`) nf.remove();
    else {
      let shown = false; // waits for the opening to finish
      let folded = saved === `${bvid}:folded`; // the reader folded it away
      let away = false; // the film's own stage is on screen
      let reading = false; // scrolled on into the chapters
      let openedAt = -1; // where the reader unfolded it by hand

      const render = () => {
        const state = !shown || away ? 'off' : folded || reading ? 'tab' : 'card';
        if (nf.dataset.state === state) return;
        // Keep the keyboard on whichever face is showing.
        const focused = nf.contains(document.activeElement);
        nf.dataset.state = state;
        card.inert = state !== 'card';
        tab.inert = state !== 'tab';
        if (focused) (state === 'card' ? card.querySelector<HTMLElement>('.nf-open') : state === 'tab' ? tab : null)?.focus({ preventScroll: true });
      };

      // Open at the top of the page; fold once the reader is into the chapters
      // (on a phone, as soon as they scroll), or has scrolled a little way past
      // where they unfolded it.
      const phone = () => innerWidth < 640;
      const into = (y: number) => y > (phone() ? 80 : innerHeight * 0.55);
      let frame = 0;
      const onScroll = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const y = scrollY;
          if (openedAt >= 0 && Math.abs(y - openedAt) < (phone() ? 220 : 360)) reading = false;
          else {
            openedAt = -1;
            reading = into(y);
          }
          render();
        });
      };
      addEventListener('scroll', onScroll, { passive: true });
      reading = into(scrollY);

      // The Films chapter shows this film full size; the card makes way for it.
      const stage = document.querySelector(`.film-feature[data-bvid="${bvid}"]`);
      if (stage) new IntersectionObserver(([entry]) => { away = entry.isIntersecting; render(); }, { threshold: 0.2 }).observe(stage);

      nf.addEventListener('click', (event) => {
        const action = (event.target as HTMLElement).closest<HTMLElement>('[data-nf]')?.dataset.nf;
        if (action === 'fold') {
          folded = true;
          remember(`${bvid}:folded`);
          render();
        } else if (action === 'unfold') {
          folded = false;
          reading = false;
          openedAt = scrollY;
          remember(null);
          render();
        } else if (action === 'close') {
          remember(`${bvid}:closed`);
          removeEventListener('scroll', onScroll);
          const focused = nf.contains(document.activeElement);
          shown = false;
          render();
          if (focused) document.getElementById('main-content')?.focus({ preventScroll: true });
          setTimeout(() => nf.remove(), 800);
        }
      });

      const begin = () => setTimeout(() => { shown = true; render(); }, 1400);
      if (root.dataset.intro === 'pending' || root.dataset.intro === 'playing') addEventListener('intro:done', begin, { once: true });
      else begin();
    }
  }
</script>
