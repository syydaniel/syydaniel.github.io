---
import { journey, researchCities, tagT } from '../data/journey';
import type { Loc } from '../data/journey';
import { LANG_CODES, type Lang } from '../data/i18n';
import { journeyFilms } from '../data/films';
import FilmPoster from './FilmPoster.astro';

const sorted = [...journey].sort((a, b) => (a.start < b.start ? 1 : -1));

// Localized month labels for date ranges.
const MONTHS_EN = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const PRESENT: Record<Lang, string> = { en: 'present', zh: '至今' };

function fmtMonth(s: string, lang: Lang): string {
  const [y, m] = s.split('-');
  const mi = parseInt(m, 10) - 1;
  if (lang === 'zh') return `${y} 年 ${mi + 1} 月`;
  return `${MONTHS_EN[mi] || ''} ${y}`;
}
function dateLoc(item: { start: string; end: string; ongoing?: boolean; status?: string }): Loc {
  // The next chapter has no dates yet.
  if (item.status === 'upcoming') return { en: 'From 2026', zh: '2026 年起' };
  const out = {} as Loc;
  for (const code of LANG_CODES) {
    const start = fmtMonth(item.start, code);
    const end = item.ongoing ? PRESENT[code] : fmtMonth(item.end, code);
    out[code] = `${start} → ${end}`;
  }
  return out;
}

// Spread data-i18n-self only for multilingual values; show English as fallback.
const selfAttr = (v: string | Loc) => (typeof v === 'string' ? {} : { 'data-i18n-self': JSON.stringify(v) });
const txt = (v: string | Loc) => (typeof v === 'string' ? v : v.en);
const tagLoc = (tag: string): string | Loc => tagT[tag] ?? tag;
---

<section id="journey" class="chapter relative">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 reveal">
      <div>
        <span class="section-eyebrow" data-chapter="02" data-i18n="journey.eyebrow">Research journey</span>
        <h2 class="section-title mt-4 max-w-2xl">
          <span data-i18n="journey.title.a">Four countries. Four universities.</span>
          <span class="text-gradient" data-i18n="journey.title.b">One question</span>
          <span data-i18n="journey.title.c">: how do land, water and climate respond to human pressure?</span>
        </h2>
      </div>
      <div class="flex gap-2 flex-wrap" id="journey-filters">
        <button class="journey-filter chip active" data-filter="all" data-i18n="journey.filter.all">All</button>
        <button class="journey-filter chip chip-sol" data-filter="education" data-i18n="journey.filter.education">Education</button>
        <button class="journey-filter chip chip-moss" data-filter="experience" data-i18n="journey.filter.experience">Experience</button>
        <button class="journey-filter chip" data-filter="project" data-i18n="journey.filter.project">Projects</button>
      </div>
    </div>

    <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10">
      <!-- timeline -->
      <div class="relative">
        <div class="journey-line absolute left-[11px] top-3 bottom-3 w-px bg-gradient-to-b from-aqua-400/60 via-ink-600 to-transparent"></div>
        <ul class="space-y-6" id="journey-list">
          {
            sorted.map((item) => (
              <li class="journey-item reveal relative pl-10" data-kind={item.kind} data-id={item.id}>
                <span
                  class={`absolute left-0 top-4 w-6 h-6 rounded-full border-2 flex items-center justify-center ${
                    item.kind === 'education'
                      ? 'bg-sol-500/15 border-sol-400'
                      : item.kind === 'experience'
                      ? 'bg-moss-500/15 border-moss-400'
                      : 'bg-aqua-500/15 border-aqua-400'
                  }`}
                >
                  <span
                    class={`w-1.5 h-1.5 rounded-full ${
                      item.kind === 'education' ? 'bg-sol-400' : item.kind === 'experience' ? 'bg-moss-400' : 'bg-aqua-400'
                    }`}
                  ></span>
                </span>

                <article class="glass rounded-2xl p-5 md:p-6 card-hover" data-coords={JSON.stringify(item.coords)}>
                  <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div>
                      <div class="flex items-center gap-2 flex-wrap">
                        {item.status === 'upcoming' ? (
                          <span class="chip chip-sol" data-i18n="journey.next">Next chapter</span>
                        ) : (
                          <Fragment>
                            <span
                              class={`chip ${item.kind === 'education' ? 'chip-sol' : item.kind === 'experience' ? 'chip-moss' : ''}`}
                              data-i18n={`journey.kind.${item.kind}`}
                            >
                              {item.kind}
                            </span>
                            {item.ongoing && <span class="chip" data-i18n="journey.ongoing">Ongoing</span>}
                          </Fragment>
                        )}
                      </div>
                      <h3 class="font-display text-xl md:text-2xl text-ink-100 mt-3 leading-snug" {...selfAttr(item.title)}>{txt(item.title)}</h3>
                      <p class="text-ink-300 text-sm mt-1"><span {...selfAttr(item.org)}>{txt(item.org)}</span> · <span {...selfAttr(item.location)}>{txt(item.location)}</span></p>
                    </div>
                    <span class="font-mono text-xs text-ink-400 shrink-0" data-i18n-self={JSON.stringify(dateLoc(item))}>
                      {dateLoc(item).en}
                    </span>
                  </div>
                  {item.supervisor && (
                    <p class="text-xs text-ink-400 mt-3">
                      <span data-i18n="journey.supervisor">Supervisor</span>: <span class="text-ink-200">{item.supervisor}</span>
                    </p>
                  )}
                  <p class="text-ink-200 text-sm mt-3 leading-relaxed" {...selfAttr(item.summary)}>{txt(item.summary)}</p>
                  {item.bullets && (
                    <ul class="mt-3 space-y-1 text-sm text-ink-300 list-disc pl-4 marker:text-aqua-400">
                      {item.bullets.map((b) => (
                        <li {...selfAttr(b)}>{txt(b)}</li>
                      ))}
                    </ul>
                  )}
                  {journeyFilms[item.id] && (
                    <div class="mt-5 pt-4 border-t border-line">
                      <p class="meta-line mb-3"><span class="!text-aqua-500" data-i18n="journey.films">Filmed in this chapter</span><i>·</i><span>{journeyFilms[item.id].length}</span></p>
                      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        {journeyFilms[item.id].map((bv) => <FilmPoster bvid={bv} size="sm" />)}
                      </div>
                    </div>
                  )}
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {item.tags.map((t) => {
                      const tl = tagLoc(t);
                      return <span class="px-2.5 py-1 rounded-full bg-ink-100/5 border border-line text-[11px] text-ink-300" {...selfAttr(tl)}>{txt(tl)}</span>;
                    })}
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- map -->
      <aside class="lg:sticky lg:top-28 self-start">
        <div class="glass rounded-2xl p-5 reveal">
          <div class="flex items-center justify-between mb-3">
            <p class="section-eyebrow !tracking-[0.22em]" data-i18n="journey.places">Places</p>
            <span class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="journey.hover_hint">Hover a card</span>
          </div>
          <div
            id="journey-map"
            class="w-full aspect-square rounded-xl overflow-hidden bg-ink-800 border border-line mounted"
          ></div>
          <ul class="mt-4 space-y-2">
            {
              researchCities.map((c) => (
                <li class="flex items-start gap-3 text-sm" data-city={c.id}>
                  <span class="mt-1.5 w-2 h-2 rounded-full bg-aqua-400 shrink-0"></span>
                  <div>
                    <div class="text-ink-100"><span {...selfAttr(c.name)}>{txt(c.name)}</span><span class="text-ink-400">, <span {...selfAttr(c.country)}>{txt(c.country)}</span></span></div>
                    <div class="text-ink-400 text-xs" {...selfAttr(c.role)}>{txt(c.role)}</div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  // Filter chips
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.journey-filter');
  const items = document.querySelectorAll<HTMLElement>('.journey-item');
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      items.forEach((i) => {
        const match = f === 'all' || i.dataset.kind === f;
        i.style.display = match ? '' : 'none';
      });
    });
  });

  // The atlas loads lazily, only when the map nears the viewport.
  import { createAtlas } from '../scripts/atlas';
  const el = document.getElementById('journey-map');
  if (el) {
    let started = false;
    const initMap = async () => {
      if (started) return;
      started = true;
      const { map, maplibregl } = await createAtlas(el, { center: [20, 40], zoom: 0.9, maxZoom: 6, detail: false, controls: false });
      {
        const cards = document.querySelectorAll<HTMLElement>('[data-coords]');
        cards.forEach((card) => {
          try {
            const coords = JSON.parse(card.dataset.coords || '[]');
            if (!Array.isArray(coords) || coords.length !== 2) return;
            const pin = document.createElement('div');
            pin.className = 'research-pin';
            new maplibregl.Marker({ element: pin }).setLngLat(coords as [number, number]).addTo(map);
          } catch {}
        });
        cards.forEach((card) => {
          card.addEventListener('mouseenter', () => {
            try {
              const coords = JSON.parse(card.dataset.coords || '[]');
              if (Array.isArray(coords) && coords.length === 2) map.flyTo({ center: coords as [number, number], zoom: 3.6, speed: 1.2, curve: 1.3 });
            } catch {}
          });
        });
      }
    };
    const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { io.disconnect(); initMap(); } }, { rootMargin: '300px' });
    io.observe(el);
  }
</script>

<style>
  .journey-filter.active {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--daiqing) 60%, transparent);
  }
</style>
