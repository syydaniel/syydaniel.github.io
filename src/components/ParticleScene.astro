---
interface Props { ambient?: boolean; }
const { ambient = false } = Astro.props;
const initialMode = ambient ? 1 : 0;
const modes = [
  { key: 'terrain', label: 'Terrain' },
  { key: 'orbit', label: 'Orbit' },
  { key: 'flow', label: 'Flow' }
];
---

<div id="particle-scene" class:list={["sculpture", {"sculpture-ambient": ambient}]} data-initial-mode={initialMode} data-shape={initialMode} data-motion="paused">
  <div class="sculpture-heading">
    <span class="scene-kicker"><i aria-hidden="true"></i><span data-i18n="scene.eyebrow">A study in quiet motion</span></span>
    <span class="scene-index" aria-hidden="true">FIG. 01 / 03</span>
  </div>
  <div class="particle-stage">
    <div class="sculpture-halo" aria-hidden="true"></div>
    <svg class="particle-fallback" viewBox="0 0 500 440" aria-hidden="true">
      <defs>
        <radialGradient id="particle-glow"><stop stop-color="#c7e9d6" stop-opacity=".18"/><stop offset="1" stop-color="#9edbc1" stop-opacity="0"/></radialGradient>
        <linearGradient id="particle-line" x2="1" y2="1"><stop stop-color="#e7f0d5"/><stop offset="1" stop-color="#77b6a9" stop-opacity=".25"/></linearGradient>
      </defs>
      <circle cx="250" cy="220" r="190" fill="url(#particle-glow)"/>
      <g class="fallback-terrain" fill="none" stroke="url(#particle-line)" stroke-width="1" stroke-dasharray="1 5" stroke-linecap="round">
        <circle cx="250" cy="220" r="144"/><ellipse cx="250" cy="220" rx="144" ry="34"/><ellipse cx="250" cy="220" rx="144" ry="72"/><ellipse cx="250" cy="220" rx="144" ry="110"/><ellipse cx="250" cy="220" rx="34" ry="144"/><ellipse cx="250" cy="220" rx="72" ry="144"/><ellipse cx="250" cy="220" rx="110" ry="144"/>
      </g>
      <g class="fallback-orbit" fill="none" stroke="url(#particle-line)" stroke-dasharray="1 4" stroke-linecap="round" transform="rotate(-25 250 220)">
        {[0, 1, 2, 3, 4, 5].map(i => <ellipse cx="250" cy="220" rx={155 - i * 12} ry={100 - i * 10} />)}
      </g>
      <g class="fallback-flow" fill="none" stroke="url(#particle-line)" stroke-dasharray="1 4" stroke-linecap="round">
        {Array.from({length: 15}, (_, i) => <path d={`M 70 ${125 + i * 10} Q 160 ${50 + i * 11} 250 ${170 + i * 9} T 430 ${155 + i * 10}`} />)}
      </g>
    </svg>
    <canvas id="particle-canvas" aria-hidden="true"></canvas>
    <span class="stage-cross stage-cross-top" aria-hidden="true">+</span>
    <span class="stage-cross stage-cross-bottom" aria-hidden="true">+</span>
    <span class="stage-coordinate" aria-hidden="true">SOIL · WATER · LIGHT</span>
  </div>
  <div class="scene-console glass liquid-glass" data-refract>
    <div class="particle-modes" role="group" aria-label="Particle form" data-i18n-attr='{"aria-label":"scene.forms"}'>
      {modes.map((mode, i) => (
        <button type="button" data-particle-mode={i} aria-pressed={i === initialMode ? 'true' : 'false'}>
          <span class="mode-number" aria-hidden="true">0{i + 1}</span><span data-i18n={`scene.${mode.key}`}>{mode.label}</span>
        </button>
      ))}
    </div>
    <button id="particle-pause" type="button" class="scene-pause" aria-pressed="true" aria-label="Pause particle atmosphere" data-i18n-attr='{"aria-label":"scene.pause"}'>
      <svg class="pause-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z"/></svg>
      <svg class="resume-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7z"/></svg>
    </button>
  </div>
  <p class="scene-hint" data-i18n="scene.hint">Choose an atmosphere. Drag the globe to explore.</p>
</div>

<script>
  import { initParticleScene } from '../scripts/particle-scene';
  initParticleScene();
</script>

<style>
  .sculpture { position: relative; width: 100%; min-width: 0; }
  .sculpture-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0 1rem; }
  .scene-kicker, .scene-index, .stage-coordinate { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: .16em; text-transform: uppercase; color: #9aafa9; }
  .scene-kicker { display: inline-flex; align-items: center; gap: .6rem; }
  .scene-kicker i { width: 5px; height: 5px; background: #bce9cb; border-radius: 50%; box-shadow: 0 0 10px #bce9cb55; }
  .scene-index { color: #748881; white-space: nowrap; }
  .particle-stage { position: relative; width: 100%; aspect-ratio: 1.12; }
  .sculpture-halo { position: absolute; inset: 8%; border-radius: 50%; background: radial-gradient(ellipse, #83bda714, #83bda707 45%, transparent 70%); }
  .particle-fallback, canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas { opacity: 0; transition: opacity 1s ease; }
  .sculpture[data-ready] canvas { opacity: 1; }
  .sculpture[data-ready] .particle-fallback { visibility: hidden; }
  .fallback-orbit, .fallback-flow { display: none; }
  .sculpture[data-shape="1"] .fallback-terrain, .sculpture[data-shape="2"] .fallback-terrain { display: none; }
  .sculpture[data-shape="1"] .fallback-orbit, .sculpture[data-shape="2"] .fallback-flow { display: block; }
  .stage-cross { position: absolute; color: #adc8b86b; font-family: monospace; font-size: 18px; font-weight: 200; pointer-events: none; }
  .stage-cross-top { top: 12%; right: 8%; }
  .stage-cross-bottom { bottom: 14%; left: 6%; }
  .stage-coordinate { position: absolute; right: 0; top: 50%; writing-mode: vertical-rl; font-size: 8px; color: #788e83; }
  .scene-console { position: relative; display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: .55rem; max-width: 355px; margin: -1rem auto 0; border-radius: 18px; }
  .particle-modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: .2rem; flex: 1; }
  .particle-modes button { display: flex; align-items: center; justify-content: center; gap: .4rem; min-height: 42px; padding: .5rem; border-radius: 12px; font-size: 11px; color: #a5b8b0; transition: background .25s, color .25s, box-shadow .25s; }
  .particle-modes button:hover { color: #eff5ec; background: #ffffff08; }
  .particle-modes button[aria-pressed="true"] { color: #e3f5df; background: #c4e6cf14; box-shadow: inset 0 1px 0 #ffffff12; }
  .mode-number { font-family: monospace; font-size: 9px; opacity: .5; }
  .scene-pause { width: 42px; height: 42px; display: flex; justify-content: center; align-items: center; border-left: 1px solid #ffffff10; color: #c0d1c7; }
  .resume-icon { display: none; }
  .sculpture[data-motion="paused"] .resume-icon { display: block; }
  .sculpture[data-motion="paused"] .pause-icon { display: none; }
  .scene-hint { margin-top: 1rem; text-align: center; font-size: 10px; color: #8fa69c; letter-spacing: .03em; }
  .sculpture[data-renderer="fallback"] .scene-pause { display: none; }
  .sculpture-ambient { position: absolute; inset: 0; pointer-events: none; }
  .sculpture-ambient .sculpture-heading { position: absolute; top: -10px; left: 0; right: 0; }
  .sculpture-ambient .particle-stage { position: absolute; inset: -35px -25px 65px; width: auto; aspect-ratio: auto; opacity: .45; }
  .sculpture-ambient .scene-console { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); width: min(355px, 100%); margin: 0; pointer-events: auto; z-index: 3; }
  .sculpture-ambient .scene-hint { position: absolute; bottom: 0; width: 100%; }
  .sculpture-ambient .stage-cross, .sculpture-ambient .stage-coordinate { display: none; }
  @media (max-width: 640px) {
    .sculpture-heading { padding: 0; }
    .scene-console { max-width: 320px; }
  }
</style>
