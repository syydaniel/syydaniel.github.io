---
// 纸浑仪: a paper globe inside an armillary of hairline rings. The sphere is
// paper shaded with ink at the limb (no glow, no halo), the continents are
// stippled in ink, the countries I have walked in are stippled in 黛青 with the
// GPS footprints in 朱砂, and the research cities are joined by dashed arcs.
// Three rings turn around it on their own axes, like a 浑仪; the beads on the
// outer ring are photographs: hover one for the frame, press to open it.
// Drag to turn (it keeps turning for a moment), the page's scroll turns it too,
// and the Places list and map stay in step through window.__globeFocus.
// Both inks: the colours are read from the theme tokens on every change.
import { researchCities } from '../data/journey';
import { photos as allPhotos } from '../data/photos-loader';
import travel from '../data/travel.generated.json';

const cities = researchCities;
// At most two dozen beads, spread across the archive, newest first.
const framed = allPhotos.filter((p) => p.thumb || p.src);
const step = Math.max(1, Math.ceil(framed.length / 24));
const beads = framed.filter((_, i) => i % step === 0).slice(0, 24).map((p) => ({
  id: p.id, thumb: p.thumb || p.src, src: p.src || p.thumb, caption: p.caption ?? '', location: p.location?.name ?? ''
}));
// Visited countries (scripts/build-travel.mjs): land dots + footprint spots.
const visitedCountries = travel.countries.map(({ a3, flag, en, zh, dots, spots }) => ({ a3, flag, en, zh, dots, spots }));
---

<div class="globe-wrap relative w-full aspect-square max-w-md mx-auto">
  <canvas id="globe-canvas" class="w-full h-full"></canvas>
  <div id="globe-label" class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-full -mt-4 rounded-md p-1.5 text-xs font-mono opacity-0 transition-opacity duration-300 max-w-[220px] z-20 border"></div>
  <p class="globe-hint" aria-hidden="true">
    <span class="globe-hint-dot"></span>
    <span data-i18n="globe.hint">Drag to rotate</span>
  </p>
</div>

<div
  id="globe-lightbox"
  class="fixed inset-0 z-[120] hidden items-center justify-center bg-black/90 backdrop-blur-md p-6 cursor-zoom-out"
  aria-hidden="true"
>
  <figure class="flex flex-col items-center gap-3 max-w-5xl">
    <img id="globe-lightbox-img" alt="" class="max-h-[82vh] max-w-[90vw] rounded-xl shadow-2xl bg-ink-800" />
    <figcaption id="globe-lightbox-cap" class="text-center text-sm text-ink-300 font-mono"></figcaption>
  </figure>
</div>

<script is:inline define:vars={{ cityData: cities, beadData: beads, countryData: visitedCountries }}>
  window.__GLOBE_CITIES__ = cityData;
  window.__GLOBE_BEADS__ = beadData;
  window.__GLOBE_COUNTRIES__ = countryData;
</script>

<script>
  import * as THREE from 'three';
  import { inkTokens, rgbOf } from '../scripts/theme';
  import { subsolar } from '../scripts/sky';

  type Loc = { en: string; zh: string };
  type City = { id: string; name: Loc; country: Loc; coords: [number, number]; role: Loc };
  type Bead = { id: string; thumb: string; src: string; caption: string; location: string };
  type VisitedCountry = { a3: string; flag: string; en: string; zh: string; dots: number[]; spots: number[][] };

  const cities = ((window as any).__GLOBE_CITIES__ ?? []) as City[];
  const beadData = ((window as any).__GLOBE_BEADS__ ?? []) as Bead[];
  const visited = ((window as any).__GLOBE_COUNTRIES__ ?? []) as VisitedCountry[];
  const dotCountry = new Map<number, VisitedCountry>();
  visited.forEach((c) => c.dots.forEach((i) => dotCountry.set(i, c)));

  const canvas = document.getElementById('globe-canvas') as HTMLCanvasElement | null;
  const label = document.getElementById('globe-label');
  if (!canvas) throw new Error('no canvas');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const lang = () => (document.documentElement.dataset.lang === 'zh' ? 'zh' : 'en');
  const loc = (v: Loc | string) => (typeof v === 'string' ? v : v[lang()] ?? v.en);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
  const FRAME_RADIUS = 1.56;

  // The instrument: the globe turns inside it, the rings turn around both.
  const instrument = new THREE.Group();
  const globe = new THREE.Group();
  instrument.add(globe);
  scene.add(instrument);

  // ---- Ink for both themes ----
  const TOKENS = ['paper-2', 'paper-hi', 'ink', 'ink-3', 'daiqing', 'daiqing-2', 'zhusha', 'seal'] as const;
  const colour = (name: (typeof TOKENS)[number]) => new THREE.Color(...rgbOf(inkTokens([name])[name]));
  const isDark = () => document.documentElement.dataset.theme === 'dark';

  // ---- The sphere: paper, shaded with ink toward the limb ----
  const sphereUniforms = {
    uPaper: { value: colour('paper-2') },
    uInk: { value: colour('ink') },
    uRim: { value: colour('daiqing') },
    uDark: { value: isDark() ? 1 : 0 },
    uSun: { value: new THREE.Vector3(0, 0, 1) } // toward the Sun, in view space
  };
  const sphere = new THREE.Mesh(
    new THREE.SphereGeometry(1, 72, 72),
    new THREE.ShaderMaterial({
      uniforms: sphereUniforms,
      vertexShader: `varying vec3 vN; varying vec3 vV;
        void main() { vec4 mv = modelViewMatrix * vec4(position, 1.0); vN = normalize(normalMatrix * normal); vV = normalize(-mv.xyz); gl_Position = projectionMatrix * mv; }`,
      fragmentShader: `uniform vec3 uPaper; uniform vec3 uInk; uniform vec3 uRim; uniform float uDark; uniform vec3 uSun; varying vec3 vN; varying vec3 vV;
        void main() {
          float ndv = max(dot(vN, vV), 0.0);
          float rim = pow(1.0 - ndv, 2.6);
          float lit = dot(vN, normalize(vec3(-0.45, 0.7, 0.55))) * 0.5 + 0.5;
          // The real terminator: the half of the Earth that is in daylight right now.
          float dayside = smoothstep(-0.2, 0.22, dot(vN, uSun));
          vec3 day = mix(uPaper * mix(0.965, 1.02, lit), uInk, rim * 0.3);
          day = mix(day * vec3(0.905, 0.925, 0.935), day, dayside);
          vec3 night = uPaper * mix(0.85, 1.25, lit) + uRim * rim * 0.5;
          night = mix(night * 0.78, night + uRim * 0.05, dayside);
          gl_FragColor = vec4(mix(day, night, uDark), 1.0);
        }`
    })
  );
  globe.add(sphere);

  // ---- Land, stippled: ink for the world, 黛青 where I have been ----
  const goldenAngle = Math.PI * (3 - Math.sqrt(5));
  const landMat = new THREE.PointsMaterial({ size: 0.0135, vertexColors: true, transparent: true, opacity: 0.9, sizeAttenuation: true, depthWrite: false });
  let landGeom: THREE.BufferGeometry | null = null;
  const landVisited: boolean[] = [];
  function paintLand() {
    if (!landGeom) return;
    const ink = isDark() ? colour('ink-3') : colour('ink');
    const been = colour('daiqing');
    const col = landGeom.attributes.color as THREE.BufferAttribute;
    for (let i = 0; i < col.count; i++) {
      const c = landVisited[i] ? been : ink;
      const b = landVisited[i] ? 0.85 + ((i * 7919) % 100) / 500 : 0.55 + ((i * 104729) % 100) / 250;
      col.setXYZ(i, c.r * b, c.g * b, c.b * b);
    }
    col.needsUpdate = true;
  }
  function addLand(pos: number[], visitedFlags: boolean[]) {
    landGeom = new THREE.BufferGeometry();
    landGeom.setAttribute('position', new THREE.BufferAttribute(new Float32Array(pos), 3));
    landGeom.setAttribute('color', new THREE.BufferAttribute(new Float32Array(pos.length), 3));
    landVisited.push(...visitedFlags);
    paintLand();
    globe.add(new THREE.Points(landGeom, landMat));
  }
  function landFromMask(img: HTMLImageElement) {
    const W = img.naturalWidth, H = img.naturalHeight;
    const off = document.createElement('canvas');
    off.width = W; off.height = H;
    const octx = off.getContext('2d', { willReadFrequently: true });
    if (!octx) return landFallback();
    octx.drawImage(img, 0, 0);
    const data = octx.getImageData(0, 0, W, H).data;
    const CANDIDATES = 32000; // keep in sync with GLOBE_DOTS in scripts/build-travel.mjs
    const LAND_MAX_LUM = 8;
    const pos: number[] = [], flags: boolean[] = [];
    for (let i = 0; i < CANDIDATES; i++) {
      const y = 1 - (i / (CANDIDATES - 1)) * 2;
      const rr = Math.sqrt(Math.max(0, 1 - y * y));
      const theta = goldenAngle * i;
      const x = Math.cos(theta) * rr, z = Math.sin(theta) * rr;
      let th = Math.atan2(z, -x);
      if (th < 0) th += Math.PI * 2;
      const u = th / (Math.PI * 2);
      const v = Math.acos(Math.min(1, Math.max(-1, y))) / Math.PI;
      const idx = (Math.min(H - 1, Math.floor(v * H)) * W + Math.min(W - 1, Math.floor(u * W))) * 4;
      const lum = 0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2];
      const country = dotCountry.get(i);
      if (!country && lum >= LAND_MAX_LUM) continue;
      pos.push(x * 1.004, y * 1.004, z * 1.004);
      flags.push(!!country);
    }
    addLand(pos, flags);
  }
  function landFallback() {
    const N = 2800, pos: number[] = [], flags: boolean[] = [];
    for (let i = 0; i < N; i++) {
      const y = 1 - (i / (N - 1)) * 2, rr = Math.sqrt(Math.max(0, 1 - y * y)), theta = goldenAngle * i;
      pos.push(Math.cos(theta) * rr * 1.004, y * 1.004, Math.sin(theta) * rr * 1.004);
      flags.push(false);
    }
    addLand(pos, flags);
  }
  const maskImg = new Image();
  maskImg.onload = () => landFromMask(maskImg);
  maskImg.onerror = () => landFallback();
  maskImg.src = '/textures/earth-dark.jpg';

  // ---- Footprints: one 朱砂 spot per ~50 km walked ----
  function softDot(): THREE.CanvasTexture {
    const c = document.createElement('canvas');
    c.width = c.height = 64;
    const ctx = c.getContext('2d')!;
    const g = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    g.addColorStop(0, 'rgba(255,255,255,1)');
    g.addColorStop(0.45, 'rgba(255,255,255,0.85)');
    g.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 64, 64);
    return new THREE.CanvasTexture(c);
  }
  function latLonToVec3(lon: number, lat: number, r = 1.01): THREE.Vector3 {
    const phi = (90 - lat) * (Math.PI / 180);
    const theta = (lon + 180) * (Math.PI / 180);
    return new THREE.Vector3(-r * Math.sin(phi) * Math.cos(theta), r * Math.cos(phi), r * Math.sin(phi) * Math.sin(theta));
  }
  const spotPos: number[] = [];
  const spotCountry: VisitedCountry[] = [];
  visited.forEach((country) => country.spots.forEach(([lon, lat]) => { const v = latLonToVec3(lon, lat, 1.012); spotPos.push(v.x, v.y, v.z); spotCountry.push(country); }));
  const spotsMat = new THREE.PointsMaterial({ size: 0.034, map: softDot(), color: colour('seal'), transparent: true, depthWrite: false, opacity: 0.95, sizeAttenuation: true });
  const spotsGeom = new THREE.BufferGeometry();
  spotsGeom.setAttribute('position', new THREE.BufferAttribute(new Float32Array(spotPos), 3));
  const spotsPoints = new THREE.Points(spotsGeom, spotsMat);
  if (spotCountry.length) globe.add(spotsPoints);

  // ---- Graticule: hairlines every 30° ----
  const lineMats: THREE.LineBasicMaterial[] = [];
  function hairline(opacity: number, dashed = false): THREE.LineBasicMaterial {
    const m = dashed
      ? new THREE.LineDashedMaterial({ color: colour('ink'), transparent: true, opacity, dashSize: 0.045, gapSize: 0.03 })
      : new THREE.LineBasicMaterial({ color: colour('ink'), transparent: true, opacity });
    lineMats.push(m);
    return m;
  }
  const graticule = new THREE.Group();
  for (let lat = -60; lat <= 60; lat += 30) {
    const pts: THREE.Vector3[] = [];
    const phi = (lat * Math.PI) / 180;
    for (let i = 0; i <= 128; i++) { const t = (i / 128) * Math.PI * 2; pts.push(new THREE.Vector3(Math.cos(phi) * Math.cos(t) * 1.006, Math.sin(phi) * 1.006, Math.cos(phi) * Math.sin(t) * 1.006)); }
    graticule.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), hairline(lat === 0 ? 0.22 : 0.09)));
  }
  for (let lon = 0; lon < 180; lon += 30) {
    const pts: THREE.Vector3[] = [];
    const th = (lon * Math.PI) / 180;
    for (let i = 0; i <= 128; i++) { const t = (i / 128) * Math.PI * 2; pts.push(new THREE.Vector3(Math.cos(t) * Math.cos(th) * 1.006, Math.sin(t) * 1.006, Math.cos(t) * Math.sin(th) * 1.006)); }
    graticule.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), hairline(0.09)));
  }
  globe.add(graticule);

  // ---- The drawn limb: one ink circle that always faces the reader ----
  const limbPts: THREE.Vector3[] = [];
  for (let i = 0; i <= 160; i++) { const t = (i / 160) * Math.PI * 2; limbPts.push(new THREE.Vector3(Math.cos(t) * 1.003, Math.sin(t) * 1.003, 0)); }
  const limb = new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(limbPts), hairline(0.42));
  scene.add(limb);

  // ---- Research cities and the arcs between them ----
  type Marker = { city: City; pos: THREE.Vector3; group: THREE.Group; core: THREE.Mesh; ring: THREE.Mesh };
  const markers: Marker[] = [];
  const markerMats: THREE.MeshBasicMaterial[] = [];
  cities.forEach((city, idx) => {
    const pos = latLonToVec3(city.coords[0], city.coords[1], 1.018);
    const g = new THREE.Group();
    const primary = idx === 0;
    const coreMat = new THREE.MeshBasicMaterial({ color: primary ? colour('seal') : colour('daiqing') });
    const ringMat = new THREE.MeshBasicMaterial({ color: primary ? colour('seal') : colour('daiqing'), transparent: true, opacity: 0.5, side: THREE.DoubleSide });
    markerMats.push(coreMat, ringMat);
    (coreMat as any).__role = primary ? 'seal' : 'daiqing';
    (ringMat as any).__role = primary ? 'seal' : 'daiqing';
    const core = new THREE.Mesh(new THREE.SphereGeometry(primary ? 0.03 : 0.02, 16, 16), coreMat);
    const ring = new THREE.Mesh(new THREE.RingGeometry(0.045, 0.052, 40), ringMat);
    ring.lookAt(new THREE.Vector3(0, 0, 0));
    g.add(core, ring);
    g.position.copy(pos);
    g.lookAt(new THREE.Vector3(0, 0, 0));
    g.rotateY(Math.PI);
    globe.add(g);
    markers.push({ city, pos, group: g, core, ring });
  });
  for (let i = 0; i < markers.length; i++) for (let j = i + 1; j < markers.length; j++) {
    const p1 = markers[i].pos, p2 = markers[j].pos;
    const mid = p1.clone().add(p2).multiplyScalar(0.5);
    mid.normalize().multiplyScalar(mid.length() + 0.22 + p1.distanceTo(p2) * 0.28);
    const line = new THREE.Line(new THREE.BufferGeometry().setFromPoints(new THREE.QuadraticBezierCurve3(p1, mid, p2).getPoints(64)), hairline(0.35, true));
    line.computeLineDistances();
    globe.add(line);
  }

  // ---- The armillary: three rings on their own axes, beads on the outer one ----
  type Ring = { group: THREE.Group; speed: number; axis: THREE.Vector3 };
  const rings: Ring[] = [];
  function makeRing(radius: number, tilt: number, lean: number, speed: number, ticks: boolean): Ring {
    const group = new THREE.Group();
    const pts: THREE.Vector3[] = [];
    for (let i = 0; i <= 200; i++) { const t = (i / 200) * Math.PI * 2; pts.push(new THREE.Vector3(Math.cos(t) * radius, 0, Math.sin(t) * radius)); }
    group.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), hairline(ticks ? 0.34 : 0.22)));
    if (ticks) {
      const tickPts: THREE.Vector3[] = [];
      for (let d = 0; d < 360; d += 15) {
        const t = (d * Math.PI) / 180, len = d % 90 === 0 ? 0.05 : 0.024;
        tickPts.push(new THREE.Vector3(Math.cos(t) * radius, 0, Math.sin(t) * radius), new THREE.Vector3(Math.cos(t) * (radius + len), 0, Math.sin(t) * (radius + len)));
      }
      group.add(new THREE.LineSegments(new THREE.BufferGeometry().setFromPoints(tickPts), hairline(0.3)));
    }
    group.rotation.set(tilt, 0, lean);
    instrument.add(group);
    const ring = { group, speed, axis: new THREE.Vector3(0, 1, 0) };
    rings.push(ring);
    return ring;
  }
  makeRing(1.22, THREE.MathUtils.degToRad(66), THREE.MathUtils.degToRad(-12), 0.05, false);
  makeRing(1.3, THREE.MathUtils.degToRad(23.4), THREE.MathUtils.degToRad(8), -0.035, false);
  const outer = makeRing(1.42, THREE.MathUtils.degToRad(78), THREE.MathUtils.degToRad(18), 0.022, true);

  // Beads: the photographs ride the outer ring.
  const beadTex = softDot();
  const beadMat = new THREE.SpriteMaterial({ map: beadTex, color: colour('seal'), transparent: true, depthWrite: false, opacity: 0.95 });
  const beadHalo = new THREE.SpriteMaterial({ map: beadTex, color: colour('seal'), transparent: true, depthWrite: false, opacity: 0.0 });
  type BeadSprite = { sprite: THREE.Sprite; halo: THREE.Sprite; angle: number; data: Bead };
  const beadSprites: BeadSprite[] = [];
  beadData.forEach((data, i) => {
    const sprite = new THREE.Sprite(beadMat.clone());
    sprite.scale.setScalar(0.07);
    const halo = new THREE.Sprite(beadHalo.clone());
    halo.scale.setScalar(0.2);
    const angle = (i / beadData.length) * Math.PI * 2;
    sprite.userData.data = data;
    outer.group.add(sprite, halo);
    beadSprites.push({ sprite, halo, angle, data });
  });
  function placeBeads() {
    for (const b of beadSprites) {
      const x = Math.cos(b.angle) * 1.42, z = Math.sin(b.angle) * 1.42;
      b.sprite.position.set(x, 0, z);
      b.halo.position.set(x, 0, z);
    }
  }
  placeBeads();

  // ---- Theme: repaint on change ----
  function paintTheme() {
    sphereUniforms.uPaper.value = colour('paper-2');
    sphereUniforms.uInk.value = colour('ink');
    sphereUniforms.uRim.value = colour('daiqing');
    sphereUniforms.uDark.value = isDark() ? 1 : 0;
    const ink = colour('ink');
    lineMats.forEach((m) => m.color.copy(ink));
    markerMats.forEach((m) => m.color.copy(colour((m as any).__role)));
    spotsMat.color.copy(colour('seal'));
    beadSprites.forEach((b) => { (b.sprite.material as THREE.SpriteMaterial).color.copy(colour('seal')); (b.halo.material as THREE.SpriteMaterial).color.copy(colour('seal')); });
    paintLand();
  }
  addEventListener('themechange', () => { paintTheme(); wake(); });

  // ---- Interaction: drag with inertia, hover, press ----
  let velY = 0, velX = 0, dragging = false, lastX = 0, lastY = 0, downX = 0, downY = 0, idleSince = 0;
  let hoveredBead: BeadSprite | null = null;
  const raycaster = new THREE.Raycaster();
  raycaster.params.Points = { threshold: 0.03 };
  const pointer = new THREE.Vector2();
  function setPointer(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect();
    pointer.set(((e.clientX - rect.left) / rect.width) * 2 - 1, -((e.clientY - rect.top) / rect.height) * 2 + 1);
    raycaster.setFromCamera(pointer, camera);
  }
  const place = (x: number, y: number) => {
    if (!label) return;
    const rect = canvas.getBoundingClientRect();
    label.style.left = `${Math.max(18, Math.min(82, ((x - rect.left) / rect.width) * 100))}%`;
    label.style.top = `${Math.max(12, ((y - rect.top) / rect.height) * 100)}%`;
  };
  const hide = () => { if (label) label.style.opacity = '0'; };
  const say = (text: string, x: number, y: number) => { if (!label) return; label.textContent = text; label.style.opacity = '1'; place(x, y); };
  const esc = (s: string) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const show = (b: Bead, x: number, y: number) => {
    if (!label) return;
    label.innerHTML = `<img src="${b.thumb}" alt="" class="w-full h-auto rounded block" /><span class="block text-center mt-1.5 leading-snug">${esc(b.caption || b.location || 'Photograph')}</span>`;
    label.style.opacity = '1';
    place(x, y);
  };
  const spotWorld = new THREE.Vector3();
  function visibleSpot() {
    if (!spotCountry.length) return undefined;
    return raycaster.intersectObject(spotsPoints, false).find((h) => {
      spotWorld.fromBufferAttribute(spotsGeom.attributes.position as THREE.BufferAttribute, h.index!);
      globe.localToWorld(spotWorld);
      return spotWorld.dot(camera.position.clone().sub(spotWorld)) > 0;
    });
  }
  canvas.addEventListener('pointerdown', (e) => {
    dragging = true; lastX = downX = e.clientX; lastY = downY = e.clientY; hoveredBead = null; hide();
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (dragging) {
      velY = (e.clientX - lastX) * 0.0045;
      velX = (e.clientY - lastY) * 0.0045;
      globe.rotation.y += velY;
      globe.rotation.x = Math.max(-0.9, Math.min(0.9, globe.rotation.x + velX));
      lastX = e.clientX; lastY = e.clientY;
      idleSince = performance.now();
      return;
    }
    setPointer(e);
    const beadHit = raycaster.intersectObjects(beadSprites.map((b) => b.sprite), false)[0];
    const cityHit = raycaster.intersectObjects(markers.map((m) => m.core), false)[0];
    const spotHit = visibleSpot();
    const nearest = [beadHit, cityHit, spotHit].filter(Boolean).sort((a, b) => a!.distance - b!.distance)[0];
    hoveredBead = null;
    if (nearest && nearest === beadHit) {
      hoveredBead = beadSprites.find((b) => b.sprite === beadHit.object) ?? null;
      if (hoveredBead) show(hoveredBead.data, e.clientX, e.clientY);
      canvas.style.cursor = 'pointer';
    } else if (nearest && nearest === cityHit) {
      const m = markers[markers.findIndex((x) => x.core === cityHit.object)];
      say(`${loc(m.city.name)}, ${loc(m.city.country)} · ${loc(m.city.role)}`, e.clientX, e.clientY);
      canvas.style.cursor = 'pointer';
    } else if (nearest && nearest === spotHit) {
      const c = spotCountry[spotHit.index!];
      say(`${c.flag} ${lang() === 'zh' ? c.zh : c.en}`, e.clientX, e.clientY);
      canvas.style.cursor = 'pointer';
    } else { hide(); canvas.style.cursor = 'grab'; }
  });
  canvas.addEventListener('pointerup', (e) => {
    dragging = false;
    canvas.releasePointerCapture(e.pointerId);
    idleSince = performance.now();
    if (Math.hypot(e.clientX - downX, e.clientY - downY) < 6) {
      setPointer(e);
      const beadHit = raycaster.intersectObjects(beadSprites.map((b) => b.sprite), false)[0];
      if (beadHit) { const d = (beadHit.object as THREE.Sprite).userData.data as Bead; openLightbox(d.src || d.thumb, d.caption || d.location); return; }
      const spotHit = visibleSpot();
      if (spotHit) { const c = spotCountry[spotHit.index!]; (window as any).__placesFocus?.(c.a3, 'globe'); }
    }
  });
  canvas.addEventListener('pointerleave', hide);

  // The list and the map call this to turn the globe toward a country.
  let turnTarget: number | null = null;
  function faceLonLat(lon: number, lat: number) {
    const p = latLonToVec3(lon, lat, 1);
    // rotation.y that brings p to the +z side (toward the camera)
    let y = Math.atan2(p.x, p.z);
    turnTarget = y;
    globe.rotation.x = THREE.MathUtils.clamp((lat * Math.PI) / 180 * 0.55, -0.9, 0.9);
  }
  (window as any).__globeFocus = (a3: string) => {
    const c = visited.find((v) => v.a3 === a3);
    if (!c || !c.spots.length) return;
    const lon = c.spots.reduce((s, p) => s + p[0], 0) / c.spots.length;
    const lat = c.spots.reduce((s, p) => s + p[1], 0) / c.spots.length;
    faceLonLat(lon, lat);
    wake();
  };
  // Open on Wageningen.
  const home = cities[0]?.coords ?? [5.66, 52];
  faceLonLat(home[0], home[1]);
  globe.rotation.y = turnTarget ?? 0;
  turnTarget = null;

  // The page's scroll turns the instrument a little.
  let lastScroll = scrollY, scrollSpin = 0;
  addEventListener('scroll', () => { scrollSpin += (scrollY - lastScroll) * 0.00045; lastScroll = scrollY; wake(); }, { passive: true });
  // The reader's position tilts it toward them.
  let tiltX = 0, tiltY = 0, aimX = 0, aimY = 0;
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    addEventListener('pointermove', (e) => { aimX = (e.clientX / innerWidth - 0.5); aimY = (e.clientY / innerHeight - 0.5); }, { passive: true });
  }

  // ---- Lightbox ----
  const lightboxEl = document.getElementById('globe-lightbox');
  const lightboxImg = document.getElementById('globe-lightbox-img') as HTMLImageElement | null;
  const lightboxCap = document.getElementById('globe-lightbox-cap');
  if (lightboxEl && lightboxEl.parentElement !== document.body) document.body.appendChild(lightboxEl);
  function openLightbox(src: string, caption: string) {
    if (!lightboxEl || !lightboxImg || !src) return;
    lightboxImg.src = src;
    if (lightboxCap) lightboxCap.textContent = caption || '';
    lightboxEl.classList.remove('hidden'); lightboxEl.classList.add('flex');
    lightboxEl.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    if (!lightboxEl) return;
    lightboxEl.classList.add('hidden'); lightboxEl.classList.remove('flex');
    lightboxEl.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  lightboxEl?.addEventListener('click', closeLightbox);
  addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

  // ---- Frame ----
  function fitCamera() {
    const halfH = Math.tan((camera.fov * Math.PI) / 360);
    const halfW = halfH * (camera.aspect || 1);
    camera.position.z = Math.max(FRAME_RADIUS / halfH, FRAME_RADIUS / halfW);
  }
  function resize() {
    const rect = canvas.getBoundingClientRect();
    renderer.setSize(rect.width, rect.height, false);
    camera.aspect = (rect.width || 1) / (rect.height || 1);
    fitCamera();
    camera.updateProjectionMatrix();
  }
  resize();
  addEventListener('resize', resize);
  new ResizeObserver(resize).observe(canvas);

  // ---- Animate: only while on screen ----
  const clock = new THREE.Clock();
  let frame = 0, onScreen = false;
  function tick() {
    frame = 0;
    const t = clock.getElapsedTime();
    const dt = Math.min(0.05, clock.getDelta() || 0.016);
    const still = reduced.matches;
    if (!dragging) {
      if (turnTarget !== null) {
        let d = turnTarget - globe.rotation.y;
        d = Math.atan2(Math.sin(d), Math.cos(d));
        globe.rotation.y += d * 0.08;
        if (Math.abs(d) < 0.002) turnTarget = null;
      } else {
        const resting = performance.now() - idleSince > 2600;
        if (!still && resting) velY += (0.0011 - velY) * 0.02;
        globe.rotation.y += velY + scrollSpin;
        velY *= 0.95; velX *= 0.9;
        scrollSpin *= 0.86;
      }
    }
    if (!still) rings.forEach((r, i) => { r.group.rotateOnAxis(r.axis, r.speed * dt * (1 + Math.abs(scrollSpin) * 60)); });
    tiltX += ((still ? 0 : aimY * 0.18) - tiltX) * 0.04;
    tiltY += ((still ? 0 : aimX * 0.22) - tiltY) * 0.04;
    instrument.rotation.x = tiltX;
    instrument.rotation.y = tiltY;
    limb.quaternion.copy(camera.quaternion);
    markers.forEach((m, i) => {
      const s = 1 + Math.sin(t * 2 + i) * 0.22;
      m.ring.scale.setScalar(s);
      (m.ring.material as THREE.MeshBasicMaterial).opacity = 0.35 + Math.sin(t * 2 + i) * 0.2;
    });
    spotsMat.size = 0.032 + Math.sin(t * 2.2) * 0.004;
    beadSprites.forEach((b, i) => {
      const hovered = b === hoveredBead;
      const target = hovered ? 0.13 : 0.062 + 0.012 * Math.sin(t * 1.7 + i);
      b.sprite.scale.setScalar(b.sprite.scale.x + (target - b.sprite.scale.x) * 0.2);
      (b.halo.material as THREE.SpriteMaterial).opacity += ((hovered ? 0.35 : 0) - (b.halo.material as THREE.SpriteMaterial).opacity) * 0.2;
    });
    // Where the Sun is overhead, carried into view space with the globe's turn.
    const sun = subsolar();
    sphereUniforms.uSun.value.copy(latLonToVec3(sun.lon, sun.lat, 1)).transformDirection(globe.matrixWorld).transformDirection(camera.matrixWorldInverse);
    renderer.render(scene, camera);
    const moving = dragging || turnTarget !== null || Math.abs(velY) > 1e-5 || Math.abs(scrollSpin) > 1e-5 || !still;
    if (onScreen && !document.hidden && moving) frame = requestAnimationFrame(tick);
  }
  function wake() { if (!frame && onScreen && !document.hidden) frame = requestAnimationFrame(tick); }
  new IntersectionObserver((entries) => { onScreen = entries.some((e) => e.isIntersecting); if (onScreen) { canvas.parentElement?.classList.add('is-ready'); wake(); } }, { rootMargin: '120px' }).observe(canvas);
  document.addEventListener('visibilitychange', wake);
  addEventListener('lang:change', hide);
  paintTheme();
  renderer.render(scene, camera);
</script>

<style>
  #globe-canvas { cursor: grab; display: block; }
  #globe-canvas:active { cursor: grabbing; }
  .globe-wrap { filter: drop-shadow(0 22px 40px color-mix(in srgb, var(--shadow) 16%, transparent)); opacity: 0; transform: scale(0.94) translateY(12px); transition: opacity 1.1s ease, transform 1.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .globe-wrap.is-ready { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .globe-wrap { opacity: 1; transform: none; transition: none; } }
  #globe-label { background: color-mix(in srgb, var(--paper-hi) 96%, transparent); color: var(--ink); border-color: var(--line); box-shadow: 0 10px 30px -14px color-mix(in srgb, var(--shadow) 30%, transparent); }
  .globe-hint { position: absolute; left: 50%; bottom: -0.4rem; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 0.5rem; width: max-content; max-width: 100%; box-sizing: border-box; padding: 0 0.5rem; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 9px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--ink-4); text-align: center; line-height: 1.7; pointer-events: none; }
  .globe-hint-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--daiqing); }
</style>
