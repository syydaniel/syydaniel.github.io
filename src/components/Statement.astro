---
// A typographic statement between About and the archive strip: three lines set
// in alternating upright, italic and outlined Fraunces, each phrase rising out
// of its own mask on scroll (data-rise, see scripts/kinetics.ts).
---

<section class="statement" aria-label="Statement">
  <p class="statement-text" data-rise>
    <span class="st" data-i18n="statement.1">Rivers keep</span>
    <span class="st st-italic" data-i18n="statement.2">what we drop.</span>
    <br />
    <span class="st" data-i18n="statement.3">Soils breathe out</span>
    <span class="st st-italic" data-i18n="statement.4">what we farm.</span>
    <br />
    <span class="st st-outline" data-i18n="statement.5">I count both,</span>
    <span class="st st-gradient text-gradient" data-i18n="statement.6">and photograph the light left over.</span>
  </p>
  <span class="statement-rule" aria-hidden="true"></span>
</section>
