---
// 墨晕: the ink on the paper. Three layers of soft pools in the site's own
// inks, each drifting on its own slow course on the compositor (a transform
// and nothing else): no simulation, no WebGL, no work on the main thread, so
// the page scrolls exactly as it would without them. A fine pointer leans
// the pools a little its way. The lite page and reduced motion get the pools
// at rest. (The real-time fluid that used to run here stuttered on machines
// that could not keep its frames up, and was taken out for this.)
---
<div class="inkwash" aria-hidden="true"><i></i><i></i><i></i></div>

<script>
  import { lite } from '../scripts/lite';
  const wash = document.querySelector<HTMLElement>('.inkwash');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  if (wash && fine.matches && !reduced.matches && !lite) {
    let x = 0, y = 0, frame = 0;
    addEventListener('pointermove', (e) => {
      x = e.clientX / innerWidth - 0.5;
      y = e.clientY / innerHeight - 0.5;
      if (!frame) frame = requestAnimationFrame(() => { frame = 0; wash.style.transform = `translate3d(${(-x * 16).toFixed(1)}px, ${(-y * 12).toFixed(1)}px, 0)`; });
    }, { passive: true });
  }
</script>
