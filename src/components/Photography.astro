---
import { photos as photosInitial, isUsingSeedPhotos } from '../data/photos-loader';
import { films, filmLabel, coverThumb } from '../data/films';

const photos = photosInitial;
const total = photos.length;
const countries = new Set(photos.map((p) => p.location.country)).size;
const hasCoords = photos.filter((p) => Array.isArray(p.location?.coords) && p.location.coords.length === 2);

// Films share the timeline with the photographs, and the map where their place is known.
const timelineFilms = films.map((f) => ({
  bvid: f.bvid,
  date: f.date,
  duration: f.duration,
  label: filmLabel(f.bvid),
  title: f.poster ?? f.title,
  place: f.place ?? null,
  cover: f.featured ? f.featured.stillSm : coverThumb(f.cover, 480, 270),
  still: !!f.featured,
  coords: f.coords ?? null,
  fullTitle: f.title
}));

// year range across photos and films
const years = [...photos.map((p) => p.takenAt), ...films.map((f) => f.date)]
  .map((d) => new Date(d).getFullYear())
  .filter((n) => !isNaN(n));
const yearMin = years.length ? Math.min(...years) : new Date().getFullYear();
const yearMax = years.length ? Math.max(...years) : new Date().getFullYear();

// Month-level time range: one slider step per month, with a histogram of what was
// made each month (photos and films stacked).
const monthKeys = [...photos.map((p) => p.takenAt.slice(0, 7)), ...films.map((f) => f.date.slice(0, 7))].sort();
const firstMonth = monthKeys[0] ?? `${yearMin}-01`;
const lastMonth = monthKeys[monthKeys.length - 1] ?? firstMonth;
const monthIdx = (key: string) => {
  const [y, m] = key.split('-').map(Number);
  const [y0, m0] = firstMonth.split('-').map(Number);
  return (y - y0) * 12 + (m - m0);
};
const monthCount = monthIdx(lastMonth) + 1;
const bins = Array.from({ length: monthCount }, () => ({ photos: 0, films: 0 }));
photos.forEach((p) => bins[monthIdx(p.takenAt.slice(0, 7))].photos++);
films.forEach((f) => bins[monthIdx(f.date.slice(0, 7))].films++);
const maxBin = Math.max(1, ...bins.map((b) => b.photos + b.films));
const pctOf = (i: number) => (monthCount > 1 ? (i / (monthCount - 1)) * 100 : 0);
const barWidth = 100 / monthCount;
const yearTicks = Array.from({ length: yearMax - yearMin + 1 }, (_, k) => yearMin + k)
  .map((y) => ({ y, i: Math.max(0, monthIdx(`${y}-01`)) }))
  .filter((t) => t.i < monthCount);
---

<section id="photography" class="relative py-28 md:py-40 scroll-mt-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 reveal">
      <div>
        <span class="section-eyebrow" data-chapter="04" data-i18n="photo.eyebrow">Photography</span>
        <h2 class="section-title mt-4 max-w-3xl">
          <span data-i18n="photo.title.a">A</span> <span class="text-gradient italic font-display" data-i18n="photo.title.b">field notebook</span> <span data-i18n="photo.title.c">in light and silver.</span>
        </h2>
        <p class="mt-5 text-ink-300 max-w-2xl" data-i18n="photo.intro">
          Every pin on the map is a place I've stood with a camera; the amber frames are films. Click one to open it.
          Drag the time range to travel through the months, or switch to the timeline view, where the photographs and films share one chronological ribbon.
        </p>
      </div>
      <div class="glass rounded-2xl p-4 text-sm text-ink-300 grid grid-cols-4 gap-5 min-w-[300px]">
        <div>
          <div class="font-display text-2xl text-ink-100">{total}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="photo.stat.frames">Frames</div>
        </div>
        <div>
          <div class="font-display text-2xl text-ink-100">{films.length}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="films.stat.films">Films</div>
        </div>
        <div>
          <div class="font-display text-2xl text-ink-100">{countries}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="photo.stat.countries">Countries</div>
        </div>
        <div>
          <div class="font-display text-2xl text-ink-100">{yearMax - yearMin + 1}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="photo.stat.years">Years</div>
        </div>
      </div>
    </div>

    {
      isUsingSeedPhotos && (
        <div class="mb-6 glass-soft border-l-2 border-sol-400 rounded-xl px-4 py-3 text-sm text-ink-300">
          <strong class="text-sol-400" data-i18n="photo.demo_label">Demo mode:</strong> <span data-i18n="photo.demo_body">currently showing placeholder pins. Drop photos in /photos/ and run npm run photos:manifest.</span>
        </div>
      )
    }

    <!-- view toggle -->
    <div class="flex items-center gap-3 mb-4 reveal">
      <div class="glass-soft rounded-full p-1 inline-flex gap-1">
        <button class="view-toggle active px-4 py-1.5 rounded-full text-xs uppercase tracking-[0.2em]" data-view="map" data-i18n="photo.view.map">
          Map
        </button>
        <button class="view-toggle px-4 py-1.5 rounded-full text-xs uppercase tracking-[0.2em]" data-view="timeline" data-i18n="photo.view.timeline">
          Timeline
        </button>
      </div>
      <div class="text-xs text-ink-400 font-mono">
        <span id="photo-count">{total}</span> <span data-i18n="photo.frames_visible">frames visible</span>
        <span id="film-count-wrap"> · <span id="film-count">{films.length}</span> <span data-i18n="photo.films_visible">films</span></span>
      </div>
    </div>

    <!-- TIME RANGE (filters the map and the timeline) -->
    <div id="time-range" class="glass rounded-2xl px-5 md:px-6 pt-4 pb-2 mb-4 reveal">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-3">
        <span class="meta-line" data-i18n="photo.time_range">Time range</span>
        <span class="font-display italic text-lg text-ink-100" id="scrubber-label">{firstMonth} to {lastMonth}</span>
        <button type="button" id="scrubber-reset" class="ml-auto meta-line hover:!text-sol-400 transition-colors" data-i18n="photo.reset" hidden>Show everything</button>
      </div>
      <div class="relative mx-2.5 h-[5.5rem] select-none touch-none" id="scrubber-track">
        <!-- histogram: one bar per month, photos (aqua) under films (amber) -->
        <div class="absolute inset-x-0 top-0 h-12" aria-hidden="true">
          {
            bins.map((b, i) =>
              b.photos + b.films > 0 ? (
                <button
                  type="button"
                  tabindex="-1"
                  class="scrub-bar group absolute bottom-0 flex flex-col justify-end"
                  data-i={i}
                  style={`left:calc(${pctOf(i)}% - ${barWidth / 2}%);width:${barWidth}%;min-width:3px;height:${Math.max(12, Math.sqrt((b.photos + b.films) / maxBin) * 100)}%`}
                  title={`${b.photos ? `${b.photos} frames` : ''}${b.photos && b.films ? ' · ' : ''}${b.films ? `${b.films} film${b.films > 1 ? 's' : ''}` : ''}`}
                >
                  {b.films > 0 && <span class="block w-full rounded-t-[2px] bg-sol-400/80" style={`height:${(b.films / (b.photos + b.films)) * 100}%`} />}
                  {b.photos > 0 && <span class:list={['block w-full bg-aqua-400/80', b.films === 0 && 'rounded-t-[2px]']} style={`height:${(b.photos / (b.photos + b.films)) * 100}%`} />}
                </button>
              ) : null
            )
          }
        </div>
        <!-- track -->
        <div class="absolute inset-x-0 top-[3.25rem] h-[2px] bg-white/10 rounded-full"></div>
        <div id="scrubber-fill" class="absolute top-[3.25rem] h-[2px] bg-gradient-to-r from-aqua-400 to-sol-400 rounded-full" style="left:0%; right:0%;"></div>
        <!-- year ticks -->
        {
          yearTicks.map((t) => (
            <span class="absolute top-[3.25rem] flex flex-col items-center -translate-x-1/2 pointer-events-none" style={`left:${pctOf(t.i)}%`} aria-hidden="true">
              <span class="block w-px h-2 bg-white/20"></span>
              <span class="mt-1 font-mono text-[10px] text-ink-400">{t.y}</span>
            </span>
          ))
        }
        <button
          id="scrubber-start"
          class="scrubber-thumb absolute top-[3.3rem] w-5 h-5 -mt-2.5 -ml-2.5 rounded-full bg-ink-100 border-2 border-aqua-400 shadow-lg cursor-grab"
          style="left:0%;"
          role="slider"
          aria-label="Start month"
        ></button>
        <button
          id="scrubber-end"
          class="scrubber-thumb absolute top-[3.3rem] w-5 h-5 -mt-2.5 -ml-2.5 rounded-full bg-ink-100 border-2 border-sol-400 shadow-lg cursor-grab"
          style="left:100%;"
          role="slider"
          aria-label="End month"
        ></button>
      </div>
    </div>

    <!-- MAP VIEW -->
    <div id="photo-map-view" class="reveal">
      <div class="glass rounded-2xl overflow-hidden">
        <div id="photo-map" class="w-full h-[560px] bg-ink-800"></div>

      </div>
    </div>

    <!-- TIMELINE VIEW -->
    <div id="photo-timeline-view" class="hidden">
      <div class="glass rounded-2xl p-6 md:p-8">
        <div id="timeline-groups" class="space-y-10"></div>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-black/92 backdrop-blur-md hidden items-center justify-center p-4" aria-hidden="true">
    <button id="lightbox-close" aria-label="Close" class="absolute top-5 right-5 w-11 h-11 rounded-full glass flex items-center justify-center text-ink-100 lightbox-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    <button id="lightbox-prev" aria-label="Previous" class="absolute left-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full glass flex items-center justify-center text-ink-100 lightbox-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button id="lightbox-next" aria-label="Next" class="absolute right-5 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full glass flex items-center justify-center text-ink-100 lightbox-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <figure id="lightbox-figure" class="max-w-6xl w-full flex flex-col gap-4 items-center">
      <span class="relative inline-block rounded-xl overflow-hidden shadow-2xl"><img id="lightbox-img" alt="" class="block max-h-[78vh] w-auto bg-ink-800" /><span class="grain"></span></span>
      <figcaption id="lightbox-meta" class="text-center text-ink-300 text-sm"></figcaption>
    </figure>
  </div>
</section>

<script is:inline define:vars={{ initialPhotos: photos, timelineFilms, yearMin, yearMax, firstMonth, monthCount }}>
  window.__SITE_PHOTOS__ = initialPhotos;
  window.__TIMELINE_FILMS__ = timelineFilms;
  window.__YEAR_MIN__ = yearMin;
  window.__YEAR_MAX__ = yearMax;
  window.__FIRST_MONTH__ = firstMonth;
  window.__MONTH_COUNT__ = monthCount;
</script>

<script>
  // MapLibre is heavy (~800 KB). Load it lazily, only when the map nears view.
  let maplibregl: any = null;
  let map: any = null;

  type Photo = {
    id: string;
    src: string;
    thumb: string;
    width?: number;
    height?: number;
    takenAt: string;
    location: { name: string; country: string; coords: [number, number] };
    caption?: string;
    camera?: string;
    exposure?: string;
  };

  const allPhotos: Photo[] = ((window as unknown as { __SITE_PHOTOS__: Photo[] }).__SITE_PHOTOS__ ?? []).filter(
    (p) => Array.isArray(p.location?.coords) && p.location.coords.length === 2
  );
  type TimelineFilm = {
    bvid: string;
    date: string;
    duration: string;
    label: { en: string; zh: string };
    title: { en: string; zh: string };
    place: { en: string; zh: string } | null;
    cover: string;
    still: boolean;
    coords: [number, number] | null;
    fullTitle: { en: string; zh: string };
  };
  const allFilms: TimelineFilm[] = (window as unknown as { __TIMELINE_FILMS__: TimelineFilm[] }).__TIMELINE_FILMS__ ?? [];
  const yearMin = (window as unknown as { __YEAR_MIN__: number }).__YEAR_MIN__;
  const yearMax = (window as unknown as { __YEAR_MAX__: number }).__YEAR_MAX__;

  const firstMonth = (window as unknown as { __FIRST_MONTH__: string }).__FIRST_MONTH__;
  const monthCount = (window as unknown as { __MONTH_COUNT__: number }).__MONTH_COUNT__;
  const [y0, m0] = firstMonth.split('-').map(Number);
  // Month index from any ISO date string, counted from the first month on record.
  const monthOf = (iso: string) => {
    const y = Number(iso.slice(0, 4));
    const m = Number(iso.slice(5, 7));
    return (y - y0) * 12 + (m - m0);
  };
  let startIdx = 0;
  let endIdx = monthCount - 1;

  // ---------- MAP ----------
  const mapEl = document.getElementById('photo-map');
  let markers: any[] = [];

  function photoYear(p: Photo) {
    const y = new Date(p.takenAt).getFullYear();
    return isNaN(y) ? yearMin : y;
  }

  function visiblePhotos(): Photo[] {
    return allPhotos.filter((p) => {
      const i = monthOf(p.takenAt);
      return i >= startIdx && i <= endIdx;
    });
  }

  function visibleFilms(): TimelineFilm[] {
    return allFilms.filter((f) => {
      const i = monthOf(f.date);
      return i >= startIdx && i <= endIdx;
    });
  }

  function groupByLocation(list: Photo[]) {
    const groups = new Map<string, { coords: [number, number]; photos: Photo[]; name: string; country: string }>();
    for (const p of list) {
      const key = `${p.location.coords[0].toFixed(2)},${p.location.coords[1].toFixed(2)}`;
      const g = groups.get(key);
      if (g) {
        g.photos.push(p);
      } else {
        groups.set(key, {
          coords: p.location.coords,
          photos: [p],
          name: p.location.name,
          country: p.location.country
        });
      }
    }
    return [...groups.values()];
  }

  function updateCount() {
    const countEl = document.getElementById('photo-count');
    if (countEl) {
      const shown = visiblePhotos().length;
      countEl.textContent = String(shown);
    }
    const filmCount = document.getElementById('film-count');
    if (filmCount) filmCount.textContent = String(visibleFilms().length);
  }

  function renderMarkers() {
    updateCount();
    if (!map || !maplibregl) return;
    markers.forEach((m) => m.remove());
    markers = [];
    const groups = groupByLocation(visiblePhotos());
    for (const g of groups) {
      const el = document.createElement('div');
      el.className = 'photo-pin';
      el.dataset.count = String(g.photos.length);
      const thumb = g.photos[0]?.thumb || g.photos[0]?.src;
      if (thumb) {
        el.style.backgroundImage = `url(${thumb})`;
      } else {
        el.style.background = 'linear-gradient(135deg, #14c7b8, #ff9f43)';
      }
      el.addEventListener('click', () => openLightbox(g.photos, 0));
      const marker = new maplibregl.Marker({ element: el, anchor: 'center' }).setLngLat(g.coords).addTo(map);
      markers.push(marker);
    }

    // Film pins: amber poster frames, nudged up-right so they never hide a photo pin.
    const lang = document.documentElement.dataset.lang === 'zh' ? 'zh' : 'en';
    const filmGroups = new Map<string, TimelineFilm[]>();
    for (const f of visibleFilms()) {
      if (!f.coords) continue;
      // ~2° buckets: films shot a few kilometres apart share one pin.
      const key = `${Math.round(f.coords[0] / 2)},${Math.round(f.coords[1] / 2)}`;
      filmGroups.set(key, [...(filmGroups.get(key) ?? []), f]);
    }
    for (const group of filmGroups.values()) {
      const el = document.createElement('div');
      el.className = 'film-pin';
      el.dataset.count = String(group.length);
      const lead = group[0];
      el.setAttribute('role', 'button');
      el.setAttribute('aria-label', `Play: ${lead.fullTitle.en}`);
      el.style.backgroundImage = `linear-gradient(rgba(5,6,10,.25), rgba(5,6,10,.25)), url(${lead.cover})`;
      let popup: any = null;
      if (group.length === 1) {
        el.dataset.film = lead.bvid;
      } else {
        popup = new maplibregl.Popup({ offset: 28, closeButton: false, maxWidth: '280px' }).setHTML(
          `<div class="p-3 space-y-1.5">` +
            group
              .map(
                (f) =>
                  `<button type="button" data-film="${f.bvid}" class="group flex w-full items-center gap-2.5 text-left">` +
                  `<span class="play-dot h-6 w-6 shrink-0"><svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor" class="ml-px"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg></span>` +
                  `<span class="min-w-0"><span class="block font-display italic text-sm text-ink-100 truncate group-hover:text-sol-400">${escapeHtml(f.title[lang])}</span>` +
                  `<span class="meta-line !text-[9px]">${f.date.replaceAll('-', '.')}<i>·</i>${f.duration}</span></span></button>`
              )
              .join('') +
            `</div>`
        );
      }
      const marker = new maplibregl.Marker({ element: el, anchor: 'bottom-left', offset: [10, -8] }).setLngLat(lead.coords!).addTo(map);
      if (popup) marker.setPopup(popup);
      markers.push(marker);
    }
  }


  let mapStarted = false;
  async function initMap() {
    if (mapStarted || !mapEl) return;
    mapStarted = true;
    await import('maplibre-gl/dist/maplibre-gl.css');
    maplibregl = (await import('maplibre-gl')).default;

    map = new maplibregl.Map({
      container: mapEl,
      style: {
        version: 8,
        sources: {
          basemap: {
            type: 'raster',
            tiles: ['https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}'],
            tileSize: 256,
            maxzoom: 16,
            attribution: 'Tiles © Esri, HERE, Garmin, © OpenStreetMap contributors'
          }
        },
        layers: [{ id: 'basemap', type: 'raster', source: 'basemap' }]
      },
      center: [20, 30],
      zoom: 1.3,
      attributionControl: true,
      dragRotate: false
    });

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    map.on('load', () => {
      renderMarkers();
      // fit bounds to initial photos
      const pts = visiblePhotos();
      if (pts.length) {
        const bounds = new maplibregl.LngLatBounds();
        pts.forEach((p) => bounds.extend(p.location.coords));
        visibleFilms().forEach((f) => f.coords && bounds.extend(f.coords));
        map.fitBounds(bounds, { padding: 80, maxZoom: 4, duration: 1400 });
      }
    });
  }

  if (mapEl) {
    const mapIO = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          mapIO.disconnect();
          initMap();
        }
      },
      { rootMargin: '300px' }
    );
    mapIO.observe(mapEl);
  }

  // ---------- TIME RANGE ----------
  const trackEl = document.getElementById('scrubber-track') as HTMLElement;
  const startThumb = document.getElementById('scrubber-start') as HTMLElement;
  const endThumb = document.getElementById('scrubber-end') as HTMLElement;
  const fillEl = document.getElementById('scrubber-fill') as HTMLElement;
  const label = document.getElementById('scrubber-label') as HTMLElement;
  const resetBtn = document.getElementById('scrubber-reset') as HTMLButtonElement;
  const bars = [...document.querySelectorAll<HTMLElement>('.scrub-bar')];

  const MONTHS_EN = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const lastIdx = Math.max(1, monthCount - 1);
  const pctFor = (i: number) => (i / lastIdx) * 100;
  const monthName = (i: number) => {
    const t = y0 * 12 + (m0 - 1) + i;
    const y = Math.floor(t / 12);
    const m = t % 12;
    return document.documentElement.dataset.lang === 'zh' ? `${y} 年 ${m + 1} 月` : `${MONTHS_EN[m]} ${y}`;
  };
  const clamp = (i: number) => Math.max(0, Math.min(monthCount - 1, i));

  function updateUI() {
    const a = pctFor(startIdx);
    const b = pctFor(endIdx);
    startThumb.style.left = `${a}%`;
    endThumb.style.left = `${b}%`;
    fillEl.style.left = `${a}%`;
    fillEl.style.right = `${100 - b}%`;
    const zh = document.documentElement.dataset.lang === 'zh';
    label.textContent = startIdx === endIdx ? monthName(startIdx) : `${monthName(startIdx)} ${zh ? '至' : 'to'} ${monthName(endIdx)}`;
    bars.forEach((bar) => {
      const i = Number(bar.dataset.i);
      bar.classList.toggle('is-out', i < startIdx || i > endIdx);
    });
    resetBtn.hidden = startIdx === 0 && endIdx === monthCount - 1;
    for (const [el, v] of [[startThumb, startIdx], [endThumb, endIdx]] as const) {
      el.setAttribute('aria-valuemin', '0');
      el.setAttribute('aria-valuemax', String(monthCount - 1));
      el.setAttribute('aria-valuenow', String(v));
      el.setAttribute('aria-valuetext', monthName(v));
    }
    renderMarkers();
    renderTimeline();
  }

  const idxAt = (clientX: number) => {
    const rect = trackEl.getBoundingClientRect();
    return clamp(Math.round(((clientX - rect.left) / rect.width) * lastIdx));
  };

  function drag(thumb: HTMLElement, which: 'start' | 'end') {
    let active = false;
    const set = (i: number) => {
      if (which === 'start') startIdx = Math.min(clamp(i), endIdx);
      else endIdx = Math.max(clamp(i), startIdx);
    };
    thumb.addEventListener('pointerdown', (e: PointerEvent) => {
      active = true;
      thumb.setPointerCapture(e.pointerId);
      thumb.style.cursor = 'grabbing';
    });
    const up = (e: PointerEvent) => {
      active = false;
      thumb.releasePointerCapture(e.pointerId);
      thumb.style.cursor = 'grab';
    };
    thumb.addEventListener('pointerup', up);
    thumb.addEventListener('pointercancel', up);
    thumb.addEventListener('pointermove', (e: PointerEvent) => {
      if (!active) return;
      e.preventDefault();
      const i = idxAt(e.clientX);
      const before = which === 'start' ? startIdx : endIdx;
      set(i);
      if ((which === 'start' ? startIdx : endIdx) !== before) updateUI();
    });
    // Keyboard: arrows step a month, Page Up/Down a year, Home/End jump to the ends.
    thumb.addEventListener('keydown', (e: KeyboardEvent) => {
      const cur = which === 'start' ? startIdx : endIdx;
      const step: Record<string, number> = { ArrowLeft: -1, ArrowDown: -1, ArrowRight: 1, ArrowUp: 1, PageDown: -12, PageUp: 12 };
      let next = cur;
      if (e.key in step) next = cur + step[e.key];
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = monthCount - 1;
      else return;
      e.preventDefault();
      set(next);
      updateUI();
    });
  }
  drag(startThumb, 'start');
  drag(endThumb, 'end');

  // Click a month in the histogram to look at just that month.
  bars.forEach((bar) => {
    bar.addEventListener('click', () => {
      startIdx = endIdx = Number(bar.dataset.i);
      updateUI();
    });
  });
  resetBtn.addEventListener('click', () => {
    startIdx = 0;
    endIdx = monthCount - 1;
    updateUI();
  });
  window.addEventListener('lang:change', () => updateUI());
  updateUI();

  // ---------- VIEW TOGGLE ----------
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('.view-toggle');
  const mapView = document.getElementById('photo-map-view')!;
  const timelineView = document.getElementById('photo-timeline-view')!;
  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      toggleBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      if (btn.dataset.view === 'map') {
        mapView.classList.remove('hidden');
        timelineView.classList.add('hidden');
        initMap();
        if (map) setTimeout(() => map.resize(), 60);
      } else {
        timelineView.classList.remove('hidden');
        mapView.classList.add('hidden');
        renderTimeline();
      }
    });
  });

  // ---------- TIMELINE ----------
  function renderTimeline() {
    const container = document.getElementById('timeline-groups');
    if (!container) return;

    const list = visiblePhotos().slice().sort((a, b) => (a.takenAt < b.takenAt ? 1 : -1));
    const filmList = visibleFilms();
    const lang = document.documentElement.dataset.lang === 'zh' ? 'zh' : 'en';

    // One ribbon: photos and films together, newest first, grouped by year.
    type Entry = { kind: 'photo'; date: string; photo: Photo } | { kind: 'film'; date: string; film: TimelineFilm };
    const byYear = new Map<number, Entry[]>();
    const push = (y: number, e: Entry) => byYear.set(y, [...(byYear.get(y) ?? []), e]);
    for (const p of list) push(photoYear(p), { kind: 'photo', date: p.takenAt.slice(0, 10), photo: p });
    for (const f of filmList) push(Number(f.date.slice(0, 4)), { kind: 'film', date: f.date, film: f });

    container.innerHTML = '';
    for (const [year, entries] of [...byYear.entries()].sort((a, b) => b[0] - a[0])) {
      entries.sort((a, b) => (a.date < b.date ? 1 : -1));
      const photosInYear = entries.flatMap((e) => (e.kind === 'photo' ? [e.photo] : []));
      const filmsInYear = entries.length - photosInYear.length;
      const counts = [
        photosInYear.length ? `${photosInYear.length} <span data-i18n="photo.frames">frames</span>` : '',
        filmsInYear ? `${filmsInYear} <span data-i18n="photo.films_visible">films</span>` : ''
      ].filter(Boolean).join(' · ');
      const section = document.createElement('div');
      section.innerHTML = `
        <div class="flex items-baseline gap-4 mb-4">
          <span class="font-display text-4xl md:text-5xl text-ink-100">${year}</span>
          <span class="h-px flex-1 bg-gradient-to-r from-sol-400/40 via-aqua-400/20 to-transparent"></span>
          <span class="font-mono text-xs text-ink-400">${counts}</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"></div>
      `;
      const grid = section.querySelector('.grid') as HTMLElement;
      // Busy years get month dividers so the ribbon stays readable.
      let lastMonth = '';
      entries.forEach((e) => {
        const month = e.date.slice(5, 7);
        if (entries.length > 8 && month !== lastMonth) {
          lastMonth = month;
          const divider = document.createElement('div');
          divider.className = 'col-span-full flex items-center gap-3 pt-2';
          divider.innerHTML = `<span class="meta-line !text-sol-400/90">${document.documentElement.dataset.lang === 'zh' ? `${Number(month)} 月` : MONTHS_EN[Number(month) - 1]}</span><span class="h-px flex-1 bg-white/5"></span>`;
          grid.appendChild(divider);
        }
        const tile = document.createElement('button');
        tile.type = 'button';
        tile.className = 'group relative aspect-[4/3] overflow-hidden rounded-xl bg-ink-800 border border-white/5 card-hover';
        if (e.kind === 'film') {
          const f = e.film;
          // Featured films have a real still; the rest use their Bilibili cover blurred into colour.
          const img = f.still
            ? `<img src="${f.cover}" alt="" loading="lazy" class="media-img w-full h-full object-cover"/>`
            : `<img src="${f.cover}" alt="" loading="lazy" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover scale-[1.5] blur-[20px] saturate-150 brightness-[.7] transition duration-700 group-hover:scale-[1.65] group-hover:brightness-[.8]"/>`;
          tile.dataset.film = f.bvid;
          tile.setAttribute('aria-label', `Play: ${f.title.en}`);
          tile.innerHTML = `
            ${img}
            <span class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-black/30"></span>
            <span class="grain"></span>
            <span class="absolute top-2.5 inset-x-3 flex justify-between font-mono text-[9px] tracking-[0.24em] text-ink-100/70 uppercase">
              <span class="text-sol-400/90">${f.label[lang]}</span><span>${f.date.slice(0, 4)}</span>
            </span>
            <div class="absolute inset-x-0 bottom-0 p-3 text-left flex items-end justify-between gap-2">
              <div class="min-w-0">
                <span class="rule-grow mb-2"></span>
                <div class="font-display italic text-ink-100 text-base md:text-lg leading-tight line-clamp-2">${escapeHtml(f.title[lang])}</div>
                <div class="meta-line mt-1 !text-[9px] !flex-nowrap"><span>${f.date.replaceAll('-', '.')}</span><i>·</i><span>${f.duration}</span></div>
              </div>
              <span class="play-dot h-8 w-8 shrink-0"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg></span>
            </div>
          `;
        } else {
          const p = e.photo;
          const i = photosInYear.indexOf(p);
          const bg = p.thumb || p.src;
          const place = p.location.name.split(',')[0];
          tile.innerHTML = `
            ${bg ? `<img src="${bg}" alt="${escapeHtml(p.location.name)}" loading="lazy" class="media-img w-full h-full object-cover"/>` : `<div class="w-full h-full bg-gradient-to-br from-ink-700 to-ink-800 flex items-center justify-center"><span class="text-ink-500 text-xs">${escapeHtml(p.location.name)}</span></div>`}
            <span class="grain"></span>
            <span class="absolute top-2.5 left-3 font-mono text-[9px] tracking-[0.24em] text-ink-100/60">${String(i + 1).padStart(2, '0')}A</span>
            <div class="absolute inset-x-0 bottom-0 p-3 pt-8 bg-gradient-to-t from-black/85 to-transparent text-left">
              <span class="rule-grow mb-2"></span>
              <div class="text-ink-100 text-xs font-medium truncate">${escapeHtml(place)}</div>
              <div class="meta-line mt-0.5 !text-[9px]">${e.date.replaceAll('-', '.')}</div>
            </div>
          `;
          tile.addEventListener('click', () => openLightbox(photosInYear, i));
        }
        grid.appendChild(tile);
      });
      container.appendChild(section);
    }

    if (!list.length && !filmList.length) {
      container.innerHTML = `<p class="text-ink-400 text-center py-12" data-i18n="photo.empty">No photos in this time range.</p>`;
    }
    (window as any).__applyI18n?.();
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  // ---------- LIGHTBOX ----------
  const lightbox = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbMeta = document.getElementById('lightbox-meta')!;
  let lbGroup: Photo[] = [];
  let lbIndex = 0;

  function openLightbox(group: Photo[], i: number) {
    lbGroup = group;
    lbIndex = i;
    renderLightbox();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  function renderLightbox() {
    const p = lbGroup[lbIndex];
    if (!p) return;
    if (p.src) {
      lbImg.src = p.src;
      lbImg.style.display = '';
    } else {
      lbImg.style.display = 'none';
    }
    const parts = [
      `<strong class="text-ink-100 font-normal font-display italic text-base">${escapeHtml(p.location.name)}</strong>`,
      `<span>${escapeHtml(p.location.country)}</span>`,
      `<span class="font-mono">${new Date(p.takenAt).toISOString().slice(0, 10)}</span>`
    ];
    if (p.camera) parts.push(`<span class="font-mono text-ink-400">${escapeHtml(p.camera)}</span>`);
    if (p.caption) parts.push(`<em class="text-ink-200">${escapeHtml(p.caption)}</em>`);
    lbMeta.innerHTML =
      parts.join(' · ') +
      `<div class="mt-2 text-ink-500 text-[10px] font-mono tracking-[0.24em]">${String(lbIndex + 1).padStart(2, '0')} / ${String(lbGroup.length).padStart(2, '0')}</div>`;
  }
  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => {
    lbIndex = (lbIndex - 1 + lbGroup.length) % lbGroup.length;
    renderLightbox();
  });
  document.getElementById('lightbox-next')?.addEventListener('click', () => {
    lbIndex = (lbIndex + 1) % lbGroup.length;
    renderLightbox();
  });
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  window.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowLeft') {
      lbIndex = (lbIndex - 1 + lbGroup.length) % lbGroup.length;
      renderLightbox();
    } else if (e.key === 'ArrowRight') {
      lbIndex = (lbIndex + 1) % lbGroup.length;
      renderLightbox();
    }
  });

  renderTimeline();
</script>

<style>
  .lightbox-btn { transition: background 0.3s ease, color 0.3s ease, transform 0.4s var(--ease-film); }
  .lightbox-btn:hover { background: #ffc46b; color: #05060a; transform: scale(1.06); }
  .view-toggle {
    color: #6b7190;
  }
  .view-toggle.active {
    background: rgba(56, 228, 210, 0.15);
    color: #38e4d2;
  }
  .scrubber-thumb {
    transition: transform 160ms ease;
    touch-action: none;
  }
  .scrubber-thumb:focus-visible { outline: 2px solid #ffc46b; outline-offset: 2px; }
  .scrub-bar { opacity: 0.9; transition: opacity 0.3s ease, filter 0.3s ease; cursor: pointer; }
  .scrub-bar:hover { filter: brightness(1.3); }
  .scrub-bar.is-out { opacity: 0.18; }
  .scrubber-thumb:hover,
  .scrubber-thumb:active {
    transform: scale(1.2);
  }
</style>
