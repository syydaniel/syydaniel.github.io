---
import { profile } from '../data/profile';
import { BILIBILI_SPACE } from '../data/films';

const channels = [
  { key: 'cv', label: 'CV (PDF)', value: 'Yiyang_Shen_CV_2026.pdf', href: '/Yiyang_Shen_CV_2026.pdf', hint: 'Latest version, September 2026. Education, research, awards.' },
  { key: 'transcript', label: 'Transcript (PDF)', value: 'Yiyang_Shen_Transcript.pdf', href: '/Yiyang_Shen_Transcript.pdf', hint: 'WUR academic record, kept current as new grades land.' },
  { key: 'personal', label: 'Personal', value: profile.email.personal, href: `mailto:${profile.email.personal}`, hint: 'Collaborations, photo licensing, or just to say hi. Click to copy.' },
  { key: 'bilibili', label: 'Bilibili', value: 'space.bilibili.com/437321627', href: BILIBILI_SPACE, hint: 'The short films, in full quality. Follow for new ones.' },
  { key: 'linkedin', label: 'LinkedIn', value: 'linkedin.com/in/yiyang-shen-…', href: profile.socials[0].href, hint: 'The long-form version of my journey.' }
];
---

<section id="contact" class="chapter relative">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-16">
      <div class="reveal">
        <span class="section-eyebrow" data-chapter="08" data-i18n="contact.eyebrow">Contact</span>
        <h2 class="section-title mt-4" data-i18n-flush>
          <span data-i18n="contact.title.a">Say</span>
          <span class="text-gradient italic font-display" data-i18n="contact.title.b">hello.</span>
          <span data-i18n="contact.title.c"></span>
        </h2>
        <p class="mt-6 text-ink-300 max-w-md" data-i18n="contact.intro">
          I'm looking for a PhD position in environmental modelling, and I'm always glad to talk about research
          collaborations, photography licensing, or anything to do with soils, water and climate. Pick whichever channel fits.
        </p>
        <div class="mt-10 glass rounded-2xl p-5 text-sm">
          <div class="flex items-center gap-3 text-ink-300">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <div class="text-ink-100"><span data-i18n="contact.based">Based in</span> {profile.location}</div>
              <div class="text-xs text-ink-400" data-i18n="contact.current">MSc, Wageningen University · Looking for a PhD position</div>
              <div class="text-xs text-ink-400 mt-1 contact-now" data-sky-contact hidden></div>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-4 reveal">
        {
          channels.map((c) => (
            <a
              href={c.href}
              target={c.href.startsWith('mailto:') ? '_self' : '_blank'}
              rel="noreferrer"
              class="group block glass rounded-2xl p-5 md:p-6 card-hover relative"
              data-copy={c.href.startsWith('mailto:') ? c.value : undefined}
            >
              <div class="flex items-center justify-between gap-4">
                <div>
                  <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-aqua-500 mb-2" data-i18n={`contact.channel.${c.key}`}>{c.label}</div>
                  <div class="font-display text-xl md:text-2xl text-ink-100 break-all">{c.value}</div>
                  <div class="text-ink-400 text-sm mt-1" data-i18n={`contact.channel.hint.${c.key}`}>{c.hint}</div>
                </div>
                <div class="w-11 h-11 play-dot shrink-0">
                  {c.href.startsWith('mailto:') ? (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h8" />
                    </svg>
                  ) : (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
                      <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
                    </svg>
                  )}
                </div>
              </div>
              {c.href.startsWith('mailto:') && <span class="copy-chip" aria-live="polite"><span data-i18n="contact.copied">Copied</span></span>}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* The address lands on the clipboard and a small seal says so. */
  .copy-chip { position: absolute; right: 1.25rem; top: 50%; translate: 0 -50%; padding: 0.3rem 0.6rem; border-radius: 3px; background: var(--seal); color: var(--on-seal); font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; opacity: 0; pointer-events: none; transform-origin: 60% 50%; }
  .copy-chip.is-on { animation: chip-stamp 1.8s cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes chip-stamp {
    0% { opacity: 0; transform: perspective(240px) rotateX(26deg) scale(1.3); }
    10% { opacity: 1; transform: perspective(240px) rotateX(0deg) scale(1); }
    78% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-6px); }
  }
  @media (max-width: 767px) { .copy-chip { right: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .copy-chip.is-on { animation: none; opacity: 1; } }
</style>

<script>
  // The email card copies the address; the mail app is one paste away.
  document.querySelectorAll<HTMLAnchorElement>('[data-copy]').forEach((card) => {
    const chip = card.querySelector<HTMLElement>('.copy-chip');
    card.addEventListener('click', async (e) => {
      const text = card.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return; // no clipboard: let the mailto link do its job
      }
      e.preventDefault();
      if (!chip) return;
      chip.classList.remove('is-on');
      void chip.offsetWidth;
      chip.classList.add('is-on');
      (window as any).__inkSplat?.((e.clientX || innerWidth / 2) / innerWidth, 1 - (e.clientY || innerHeight / 2) / innerHeight, 0.3, [0.52, 0.13, 0.08]);
    });
  });
</script>
