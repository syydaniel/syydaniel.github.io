---
// "Places I've been": built from my GPX tracks by scripts/build-travel.mjs.
// Tracks are snapped to ~10 km cells before they reach the repo, so the map
// shows regions, never routes.
import travel from '../data/travel.generated.json';
import { photos } from '../data/photos-loader';
import { films } from '../data/films';
import Globe from './Globe.astro';

const { stats, countries } = travel;
const CITY_PREVIEW = 8;
const years = stats.firstYear && stats.lastYear ? stats.lastYear - stats.firstYear + 1 : null;
const loc = (en: string, zh: string) => JSON.stringify({ en, zh });
const framesIn = (country: string) => photos.filter((p) => p.location.country === country).length;
const filmsIn = (a3: string) => films.filter((f) => f.a3 === a3);
---

<section id="places" class="chapter relative">
  <div class="mx-auto max-w-7xl px-6">
    <div class="places-head reveal">
      <div class="places-intro">
        <span class="section-eyebrow" data-chapter="03" data-i18n="places.eyebrow">Places</span>
        <h2 class="section-title mt-4 max-w-3xl">
          <span data-i18n="places.title.a">Everywhere my</span>
          <span class="text-gradient italic font-display" data-i18n="places.title.b">footsteps</span>
          <span data-i18n="places.title.c">have been.</span>
        </h2>
        <p class="mt-5 text-ink-300 max-w-2xl" data-i18n="places.intro">
          Drawn from years of GPS tracks I've recorded. Each glowing square is a roughly 10 km patch of
          the world I've passed through. Brighter means more time spent there.
        </p>
      <div class="glass rounded-2xl p-4 text-sm text-ink-300 grid grid-cols-3 gap-6 places-stats mt-8 max-w-md">
        <div>
          <div class="font-display text-2xl text-ink-100" data-count>{stats.countries}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="places.stat.countries">Countries</div>
        </div>
        <div>
          <div class="font-display text-2xl text-ink-100" data-count>{stats.cities}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="places.stat.cities">Cities</div>
        </div>
        <div>
          <div class="font-display text-2xl text-ink-100" data-count>{stats.km.toLocaleString('en-US')}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="places.stat.km">km tracked</div>
        </div>
      </div>
      </div>
      <div class="places-globe">
        <Globe />
      </div>
    </div>

    <div class="grid lg:grid-cols-[1.6fr_1fr] gap-6">
      <div class="glass rounded-2xl overflow-hidden reveal mounted">
        <div id="places-map" class="w-full h-[520px] bg-ink-800 relative" data-version={travel.version}></div>
        <p class="places-map-hint" aria-hidden="true"><span data-i18n="places.map_hint">Drag to turn the table · Each column is time spent in a 10 km square</span></p>
        {
          years && (
            <div class="border-t border-line px-5 py-3 text-xs font-mono text-ink-400 flex justify-between">
              <span>{stats.firstYear} to {stats.lastYear}</span>
              <span>
                {stats.days} <span data-i18n="places.days">days on the move</span>
              </span>
            </div>
          )
        }
      </div>

      <div class="glass rounded-2xl p-5 reveal lg:max-h-[570px] overflow-y-auto">
        <ul class="space-y-4">
          {
            countries.map((c) => (
              <li class="places-country" data-a3={c.a3}>
                <div class="flex items-center gap-2.5">
                  <span class="places-mark w-2 h-2 rounded-full shrink-0" aria-hidden="true"></span>
                  <span class="text-xl leading-none">{c.flag}</span>
                  <span class="text-ink-100" data-i18n-self={loc(c.en, c.zh)}>{c.en}</span>
                  <span class="ml-auto text-[10px] font-mono text-ink-500">{c.cities.length || ''}</span>
                </div>
                {c.cities.length > 0 && (
                  <p class="mt-1.5 pl-8 text-xs text-ink-400 leading-relaxed">
                    {c.cities.slice(0, CITY_PREVIEW).map((city, i) => (
                      <Fragment>
                        {i > 0 && <span class="text-ink-600"> · </span>}
                        <span data-i18n-self={loc(city.en, city.zh)}>{city.en}</span>
                      </Fragment>
                    ))}
                    {c.cities.length > CITY_PREVIEW && <span class="text-ink-500"> +{c.cities.length - CITY_PREVIEW}</span>}
                  </p>
                )}
                {(framesIn(c.en) > 0 || filmsIn(c.a3).length > 0) && (
                  <p class="mt-2 pl-8 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                    {framesIn(c.en) > 0 && (
                      <a href="#photography" class="meta-line !text-[9px] hover:!text-ink-100 transition-colors" data-photo-country={c.en}>
                        <span class="text-ink-300">{framesIn(c.en)}</span> <span data-i18n="places.frames">frames</span>
                      </a>
                    )}
                    {filmsIn(c.a3).slice(0, 2).map((f) => (
                      <button type="button" class="group inline-flex items-center gap-1.5 text-[12.5px] text-ink-300 hover:text-sol-400 transition-colors" data-film={f.bvid}>
                        <span class="play-dot h-5 w-5 shrink-0"><svg width="7" height="7" viewBox="0 0 24 24" fill="currentColor" class="ml-px"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg></span>
                        <span class="font-display italic" data-i18n-self={JSON.stringify(f.poster ?? f.title)}>{(f.poster ?? f.title).en}</span>
                      </button>
                    ))}
                    {filmsIn(c.a3).length > 2 && (
                      <a href="#films" class="meta-line !text-[9px] hover:!text-ink-100">+{filmsIn(c.a3).length - 2}</a>
                    )}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // The atlas loads only when the map nears view. Cells are the 10 km squares
  // of my GPS tracks, raised as columns by time spent: a table-top model of
  // where I have walked. The country list and the globe stay in step with it.
  import { createAtlas } from '../scripts/atlas';
  const el = document.getElementById('places-map');
  if (el) {
    let started = false;
    const initMap = async () => {
      if (started) return;
      started = true;
      const [atlas, data] = await Promise.all([
        createAtlas(el, { center: [20, 35], zoom: 1.2, maxZoom: 7, pitch: 42, bearing: -14, rotate: true, detail: false }),
        fetch(`/travel.json?v=${el.dataset.version ?? ''}`).then((r) => r.json())
      ]);
      const { map, maplibregl } = atlas;
      const cells: [number, number, number][] = data.cells;
      const maxLog = Math.log1p(Math.max(...cells.map((c) => c[2])));
      const square = (x: number, y: number, half: number, w: number, id: number) => ({
        type: 'Feature', id, properties: { w },
        geometry: { type: 'Polygon', coordinates: [[[x - half, y - half], [x + half, y - half], [x + half, y + half], [x - half, y + half], [x - half, y - half]]] }
      });
      // The 10 km squares themselves, and the same time summed into 0.25° and 1° squares for
      // the zooms where a 10 km square is less than a pixel across.
      const fine = { type: 'FeatureCollection', features: cells.map(([x, y, n], i) => square(x, y, 0.05, Math.log1p(n) / maxLog, i)) };
      const summed = (step: number) => {
        const sum = new Map<string, [number, number, number]>();
        cells.forEach(([x, y, n]) => { const k = `${Math.floor(x / step)},${Math.floor(y / step)}`; const c = sum.get(k); if (c) c[2] += n; else sum.set(k, [Math.floor(x / step) * step + step / 2, Math.floor(y / step) * step + step / 2, n]); });
        const top = Math.log1p(Math.max(...[...sum.values()].map((c) => c[2])));
        return { type: 'FeatureCollection', features: [...sum.values()].map(([x, y, n], i) => square(x, y, step / 2, Math.log1p(n) / top, i)) };
      };
      const coarse = summed(1), mid = summed(0.25);
      const dots = { type: 'FeatureCollection', features: cells.map(([x, y, n], i) => ({ type: 'Feature', id: i, properties: { w: Math.log1p(n) / maxLog }, geometry: { type: 'Point', coordinates: [x, y] } })) };
      const ramp = (ink: ReturnType<typeof atlas.ink>) => ['interpolate', ['linear'], ['get', 'w'], 0, ink.daiqing, 0.55, ink.ink, 1, ink.seal];
      const column = (ink: ReturnType<typeof atlas.ink>) => ['case', ['boolean', ['feature-state', 'hover'], false], ink.zhusha, ramp(ink)];
      // Columns keep their height on screen: metres halve as the scale doubles.
      const height = (base: number, span: number) => ['interpolate', ['exponential', 2], ['zoom'], 2, ['+', base, ['*', ['get', 'w'], span]], 9, ['+', base / 128, ['*', ['get', 'w'], span / 128]]];
      const paint = () => {
        const ink = atlas.ink();
        for (const id of ['cells-coarse', 'cells-mid', 'cells-fine']) map.setPaintProperty(id, 'fill-extrusion-color', column(ink));
        map.setPaintProperty('cells-dots', 'circle-color', ramp(ink));
        map.setPaintProperty('country-hi', 'fill-color', ink.daiqing);
        map.setPaintProperty('country-hi-line', 'line-color', ink.daiqing);
        map.setLight({ anchor: 'viewport', color: ink.dark ? '#ffffff' : ink.paperHi, intensity: ink.dark ? 0.6 : 0.35, position: [1.4, 120, 55] });
      };

      atlas.ready.then(() => {
        const ink = atlas.ink();
        map.addSource('outlines', { type: 'geojson', data: data.outlines });
        map.addSource('cells-fine', { type: 'geojson', data: fine as any });
        map.addSource('cells-coarse', { type: 'geojson', data: coarse as any });
        map.addSource('cells-mid', { type: 'geojson', data: mid as any });
        map.addSource('cells-dots', { type: 'geojson', data: dots as any });
        map.addLayer({ id: 'country-hi', type: 'fill', source: 'outlines', filter: ['==', 'a3', ''], paint: { 'fill-color': ink.daiqing, 'fill-opacity': 0.12 } }, 'graticule');
        map.addLayer({ id: 'country-hi-line', type: 'line', source: 'outlines', filter: ['==', 'a3', ''], paint: { 'line-color': ink.daiqing, 'line-opacity': 0.7, 'line-width': 1.2 } });
        map.addLayer({ id: 'cells-dots', type: 'circle', source: 'cells-dots', maxzoom: 8, paint: { 'circle-pitch-alignment': 'map', 'circle-color': ramp(ink), 'circle-opacity': 0.55, 'circle-radius': ['interpolate', ['linear'], ['zoom'], 1, 1.6, 6, 4] } });
        const columns = (id: string, source: string, zoom: { minzoom?: number; maxzoom?: number }, base: number, span: number) =>
          map.addLayer({ id, type: 'fill-extrusion', source, ...zoom, paint: { 'fill-extrusion-color': column(ink), 'fill-extrusion-height': height(base, span), 'fill-extrusion-base': 0, 'fill-extrusion-opacity': 0.9, 'fill-extrusion-vertical-gradient': true } });
        columns('cells-coarse', 'cells-coarse', { maxzoom: 3.4 }, 200000, 1900000);
        columns('cells-mid', 'cells-mid', { minzoom: 3.4, maxzoom: 5 }, 170000, 1500000);
        columns('cells-fine', 'cells-fine', { minzoom: 5 }, 140000, 1100000);
        paint();
        atlas.onTheme(paint);

        const bounds = new maplibregl.LngLatBounds();
        cells.forEach(([x, y]) => bounds.extend([x, y]));
        if (!bounds.isEmpty()) map.fitBounds(bounds, { padding: 48, maxZoom: 4.6, duration: 0, pitch: 42, bearing: -14 });

        // Hover lights a column.
        let hovered: { source: string; id: number } | null = null;
        const clear = () => { if (hovered) map.setFeatureState(hovered, { hover: false }); hovered = null; map.getCanvas().style.cursor = ''; };
        for (const layer of ['cells-coarse', 'cells-mid', 'cells-fine']) {
          map.on('mousemove', layer, (e) => {
            const id = e.features?.[0]?.id as number | undefined;
            if (id === undefined) return;
            if (hovered && hovered.id === id && hovered.source === layer) return;
            clear();
            hovered = { source: layer, id };
            map.setFeatureState(hovered, { hover: true });
            map.getCanvas().style.cursor = 'pointer';
          });
          map.on('mouseleave', layer, clear);
        }
      });

      // One focus for the list, the globe and the map.
      const items = Array.from(document.querySelectorAll<HTMLElement>('.places-country'));
      const focus = (a3: string, source?: string) => {
        items.forEach((li) => li.classList.toggle('is-focus', li.dataset.a3 === a3));
        if (map.isStyleLoaded() && map.getLayer('country-hi')) {
          map.setFilter('country-hi', ['==', 'a3', a3]);
          map.setFilter('country-hi-line', ['==', 'a3', a3]);
        }
        if (source !== 'globe') (window as any).__globeFocus?.(a3);
        if (source !== 'hover') {
          const f = (data.outlines.features as any[]).find((x) => x.properties.a3 === a3);
          if (!f) return;
          const b = new maplibregl.LngLatBounds();
          const polys = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : f.geometry.coordinates;
          polys.forEach((p: number[][][]) => p[0].forEach((pt) => b.extend(pt as [number, number])));
          map.fitBounds(b, { padding: 56, maxZoom: 5.2, duration: 1400, pitch: 34 });
          if (source === 'globe') el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      };
      (window as any).__placesFocus = focus;
      items.forEach((li) => {
        li.addEventListener('mouseenter', () => focus(li.dataset.a3!, 'hover'));
        li.addEventListener('click', () => focus(li.dataset.a3!, 'list'));
      });
    };

    const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { io.disconnect(); initMap(); } }, { rootMargin: '300px' });
    io.observe(el);
  }
</script>

<style>
  .places-country { cursor: pointer; border-radius: var(--radius); margin: 0 -0.5rem; padding: 0.35rem 0.5rem; transition: background 300ms ease; }
  .places-country:hover, .places-country.is-focus { background: color-mix(in srgb, var(--daiqing) 7%, transparent); }
  .places-mark { background: var(--daiqing); box-shadow: 0 0 0 3px color-mix(in srgb, var(--daiqing) 18%, transparent); transition: background 300ms ease, box-shadow 300ms ease; }
  .places-country.is-focus .places-mark { background: var(--seal); box-shadow: 0 0 0 3px color-mix(in srgb, var(--seal) 22%, transparent); }
  .places-country:hover .text-ink-100, .places-country.is-focus .text-ink-100 { color: var(--zhusha); }
  @media (max-width: 767px) { .places-map-hint { top: auto; bottom: 2.6rem; left: 1.2rem; max-width: 60%; } }
  .places-map-hint { position: absolute; left: 2rem; top: 1.1rem; z-index: 3; margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 9px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-4); pointer-events: none; }
</style>
