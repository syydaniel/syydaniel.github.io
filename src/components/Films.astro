---
// Films: my Bilibili uploads. Two featured films get full-bleed covers made from
// stills of the 4K masters; the rest form a year-filterable archive. Nothing
// loads from Bilibili until a film is played (covers aside), and every player
// is Bilibili's own embed.
import { films, filmNumber, BILIBILI_SPACE } from '../data/films';
import type { Loc } from '../data/journey';
import FilmPoster from './FilmPoster.astro';

const featured = films.filter((f) => f.featured);
const archive = films.filter((f) => !f.featured);
const years = [...new Set(archive.map((f) => f.date.slice(0, 4)))];
const firstYear = films[films.length - 1].date.slice(0, 4);
const totalMin = Math.round(
  films.reduce((s, f) => {
    const [m, sec] = f.duration.split(':').map(Number);
    return s + m * 60 + sec;
  }, 0) / 60
);
const ARCHIVE_PREVIEW = 8;

const self = (v: Loc) => JSON.stringify(v);
const dot = (d: string) => d.replaceAll('-', '.');
---

<section id="films" class="relative py-28 md:py-40 scroll-mt-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 reveal">
      <div>
        <span class="section-eyebrow" data-chapter="05" data-i18n="films.eyebrow">Films</span>
        <h2 class="section-title mt-4 max-w-3xl">
          <span data-i18n="films.title.a">The same places,</span>
          <span class="text-gradient italic font-display" data-i18n="films.title.b">in motion.</span>
        </h2>
        <p class="mt-5 text-ink-300 max-w-2xl" data-i18n="films.intro">
          Short films I shoot, edit and grade myself, from the Arctic to the southern tip of Africa. They live on
          Bilibili; press play to watch them here.
        </p>
      </div>
      <div class="glass rounded-2xl p-4 text-sm text-ink-300 grid grid-cols-3 gap-6 min-w-[260px]">
        <div>
          <div class="font-display text-2xl text-ink-100">{films.length}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="films.stat.films">Films</div>
        </div>
        <div>
          <div class="font-display text-2xl text-ink-100">{totalMin}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="films.stat.minutes">Minutes</div>
        </div>
        <div>
          <div class="font-display text-2xl text-ink-100">{firstYear}</div>
          <div class="text-[10px] uppercase tracking-[0.2em] text-ink-400" data-i18n="films.stat.since">Since</div>
        </div>
      </div>
    </div>

    <!-- FEATURED -->
    <div class="space-y-8 md:space-y-10">
      {
        featured.map((f) => (
          <article class="film-feature reveal" data-bvid={f.bvid}>
            <div class="film-stage group relative overflow-hidden rounded-[1.75rem] bg-ink-950 ring-1 ring-white/10">
              <button type="button" class="film-play-target absolute inset-0 z-10 w-full h-full cursor-pointer text-left" aria-label={`Play: ${f.title.en}`}>
                <img
                  src={f.featured!.still}
                  srcset={`${f.featured!.stillSm} 1200w, ${f.featured!.still} 2400w`}
                  sizes="(min-width: 1280px) 1232px, 100vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="film-still absolute inset-0 w-full h-full object-cover"
                  style={`object-position:${f.featured!.focus ?? '50% 50%'}`}
                />
                <span class="film-shade absolute inset-0" aria-hidden="true" />
                <span class="grain" aria-hidden="true" />

                <span class="absolute left-5 right-5 top-5 md:left-9 md:right-9 md:top-8 flex items-center justify-between text-[10px] md:text-[11px] font-mono uppercase tracking-[0.3em] text-ink-100/70">
                  <span>N° {filmNumber(f.bvid)}</span>
                  <span>{dot(f.date)}</span>
                </span>

                <span class="absolute inset-x-5 bottom-5 md:inset-x-auto md:right-10 md:bottom-10 md:w-[42%] flex flex-col md:items-end md:text-right">
                  {f.place && (
                    <span class="text-[10px] md:text-xs font-mono uppercase tracking-[0.32em] text-sol-400/90">
                      <span data-i18n-self={self(f.place)}>{f.place.en}</span>
                      {f.featured!.coords && <span class="text-ink-100/50"> · {f.featured!.coords}</span>}
                    </span>
                  )}
                  <span class="film-title mt-3 font-display italic text-ink-100 text-3xl sm:text-4xl lg:text-[3.4rem] leading-[1.02]" data-i18n-self={self(f.title)}>
                    {f.title.en}
                  </span>
                  <span class="mt-4 hidden sm:block text-sm text-ink-200/80 leading-relaxed max-w-md" data-i18n-self={self(f.featured!.tagline)}>
                    {f.featured!.tagline.en}
                  </span>
                  <span class="mt-6 flex items-center gap-4 md:flex-row-reverse">
                    <span class="film-play relative flex h-14 w-14 md:h-16 md:w-16 items-center justify-center rounded-full">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="ml-0.5"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg>
                    </span>
                    <span class="flex flex-col md:items-end gap-1">
                      <span class="text-[10px] uppercase tracking-[0.3em] text-ink-100/60" data-i18n="films.watch">Watch the film</span>
                      <span class="font-mono text-sm text-ink-100">{f.duration}</span>
                    </span>
                  </span>
                </span>
              </button>
            </div>
          </article>
        ))
      }
    </div>

    <!-- ARCHIVE -->
    <div class="mt-20 md:mt-28 reveal">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-7">
        <div>
          <h3 class="font-display text-2xl md:text-3xl text-ink-100" data-i18n="films.archive.title">The archive</h3>
          <p class="mt-2 text-sm text-ink-400" data-i18n="films.archive.intro">Everything else I've put on Bilibili, newest first.</p>
        </div>
        <div class="glass-soft rounded-2xl md:rounded-full p-1 inline-flex flex-wrap gap-1 self-start md:self-auto" role="tablist">
          <button class="film-year active px-3.5 py-1.5 rounded-full text-xs uppercase tracking-[0.18em]" data-year="all" data-i18n="films.all">All</button>
          {years.map((y) => (
            <button class="film-year px-3.5 py-1.5 rounded-full text-xs font-mono" data-year={y}>{y}</button>
          ))}
        </div>
      </div>

      <ul id="film-grid" class="grid gap-x-5 gap-y-9 grid-cols-2 lg:grid-cols-4">
        {
          archive.map((f, i) => (
            <li class="film-card" data-year={f.date.slice(0, 4)} data-rank={i} hidden={i >= ARCHIVE_PREVIEW}>
              <FilmPoster bvid={f.bvid} caption />
            </li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <button id="film-more" type="button" class="btn btn-ghost !py-2.5 !px-5 text-sm">
          <span data-i18n="films.more">Show all films</span>
          <span class="font-mono text-ink-400 ml-1.5">{archive.length}</span>
        </button>
        <a href={BILIBILI_SPACE} target="_blank" rel="noopener" class="text-sm text-ink-400 hover:text-sol-400 transition-colors px-3 py-2">
          <span data-i18n="films.channel">Follow on Bilibili</span> ↗
        </a>
      </div>
    </div>
  </div>

</section>

<style>
  .film-stage {
    aspect-ratio: 4 / 5;
    transition: aspect-ratio 0.6s var(--ease-film);
  }
  @media (min-width: 640px) {
    .film-stage { aspect-ratio: 16 / 9; }
  }
  @media (min-width: 1024px) {
    .film-stage { aspect-ratio: 2.39 / 1; }
  }
  .film-stage.is-playing { aspect-ratio: 16 / 9; }

  .film-still {
    transform: scale(1.04);
    transition: transform 1.6s var(--ease-film), filter 0.8s ease;
    filter: saturate(1) contrast(1.05) brightness(1.04);
  }
  .film-stage:hover .film-still {
    transform: scale(1);
    filter: saturate(1.08) contrast(1.07) brightness(1.06);
  }

  /* Shade: dark at the bottom on phones, dark on the right (under the text) from md up. */
  .film-shade {
    background:
      linear-gradient(to top, rgba(5, 6, 10, 0.92) 0%, rgba(5, 6, 10, 0.55) 38%, rgba(5, 6, 10, 0) 65%),
      linear-gradient(to bottom, rgba(5, 6, 10, 0.55) 0%, rgba(5, 6, 10, 0) 22%);
  }
  @media (min-width: 768px) {
    .film-shade {
      background:
        linear-gradient(to left, rgba(5, 6, 10, 0.88) 0%, rgba(5, 6, 10, 0.55) 34%, rgba(5, 6, 10, 0) 62%),
        linear-gradient(to bottom, rgba(5, 6, 10, 0.5) 0%, rgba(5, 6, 10, 0) 20%),
        linear-gradient(to top, rgba(5, 6, 10, 0.45) 0%, rgba(5, 6, 10, 0) 30%);
    }
  }

  .film-title { text-wrap: balance; letter-spacing: -0.01em; }

  .film-play {
    color: #05060a;
    background: rgba(238, 240, 250, 0.94);
    transition: transform 0.4s var(--ease-film), background 0.3s ease;
  }
  .film-play::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: 9999px;
    border: 1px solid rgba(238, 240, 250, 0.35);
    transition: inset 0.4s var(--ease-film), border-color 0.3s ease;
  }
  .film-stage:hover .film-play { transform: scale(1.06); background: #ffc46b; }
  .film-stage:hover .film-play::after { inset: -12px; border-color: rgba(255, 196, 107, 0.5); }

  .film-year { color: #a0a5c0; transition: color 0.2s ease, background 0.2s ease; }
  .film-year:hover { color: #eef0fa; }
  .film-year.active { background: rgba(238, 240, 250, 0.1); color: #eef0fa; }

  @media (prefers-reduced-motion: reduce) {
    .film-stage, .film-still, .film-play, .film-play::after { transition: none; }
  }
</style>

<script>
  import { bilibiliPlayer } from '../data/films';

  const makeFrame = (bvid: string) => {
    const iframe = document.createElement('iframe');
    iframe.src = bilibiliPlayer(bvid);
    iframe.title = 'Bilibili video player';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 w-full h-full border-0';
    return iframe;
  };

  // Featured: swap the cover for the player in place.
  document.querySelectorAll<HTMLElement>('.film-feature').forEach((card) => {
    const stage = card.querySelector<HTMLElement>('.film-stage')!;
    const target = card.querySelector<HTMLButtonElement>('.film-play-target')!;
    target.addEventListener('click', () => {
      stage.classList.add('is-playing');
      target.remove();
      stage.appendChild(makeFrame(card.dataset.bvid!));
    });
  });

  // Archive: year filter + show all.
  const cards = [...document.querySelectorAll<HTMLElement>('.film-card')];
  const more = document.getElementById('film-more');
  const PREVIEW = 8;
  let year = 'all';
  let expanded = false;
  const render = () => {
    cards.forEach((c) => {
      const inYear = year === 'all' || c.dataset.year === year;
      const inPreview = expanded || year !== 'all' || Number(c.dataset.rank) < PREVIEW;
      c.hidden = !(inYear && inPreview);
    });
    if (more) more.hidden = expanded || year !== 'all';
  };
  document.querySelectorAll<HTMLButtonElement>('.film-year').forEach((btn) => {
    btn.addEventListener('click', () => {
      year = btn.dataset.year || 'all';
      document.querySelectorAll('.film-year').forEach((b) => b.classList.toggle('active', b === btn));
      render();
    });
  });
  more?.addEventListener('click', () => {
    expanded = true;
    render();
  });

</script>
