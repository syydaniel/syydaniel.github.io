---
import { profile } from '../data/profile';
import { films, filmNumber } from '../data/films';
import { photos } from '../data/photos-loader';

// Newest featured film and three recent frames from different places.
const latest = films.find((f) => f.featured)!;
const places = new Set<string>();
const frames = [...photos]
  .sort((a, b) => (a.takenAt < b.takenAt ? 1 : -1))
  .filter((p) => (places.has(p.location.country) ? false : (places.add(p.location.country), true)))
  .slice(0, 3);

const skills = [
  { label: 'Water Quality', icon: '💧', key: 'about.skill.water' },
  { label: 'Microplastics', icon: '🧬', key: 'about.skill.microplastics' },
  { label: 'Scenario Analysis', icon: '📈', key: 'about.skill.scenario' },
  { label: 'Climate Change', icon: '🌍', key: 'about.skill.climate' },
  { label: 'Machine Learning', icon: '🤖', key: 'about.skill.ml' },
  { label: 'GIS Analysis', icon: '🗺️', key: 'about.skill.gis' },
  { label: 'Boreal Ecology', icon: '🌲', key: 'about.skill.boreal' },
  { label: 'Urban Forestry', icon: '🏙️', key: 'about.skill.urban' }
];
---

<section id="about" class="relative py-28 md:py-40 scroll-mt-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-16 items-start">
      <div class="reveal">
        <span class="section-eyebrow" data-chapter="01" data-i18n="about.eyebrow">About me</span>
        <h2 class="section-title mt-4">
          <span data-i18n="about.title.a">Researching the</span>
          <span class="text-gradient italic font-display" data-i18n="about.title.b">quiet systems</span>
          <span data-i18n="about.title.c">we take for granted.</span>
        </h2>

        <!-- Now showing: the latest film, then recent frames -->
        <div class="mt-12 hidden lg:block">
          <button type="button" class="group relative block w-full overflow-hidden rounded-2xl ring-1 ring-white/10 card-hover text-left" data-film={latest.bvid} aria-label={`Play: ${latest.title.en}`}>
            <span class="relative block aspect-[2.2/1]">
              <img src={latest.featured!.stillSm} alt="" loading="lazy" decoding="async" class="media-img absolute inset-0 w-full h-full object-cover" style={`object-position:${latest.featured!.focus ?? '50% 50%'}`} />
              <span class="absolute inset-0 bg-gradient-to-t from-ink-950/90 via-ink-950/20 to-ink-950/30"></span>
              <span class="grain"></span>
              <span class="absolute inset-x-4 top-3 flex justify-between font-mono text-[9px] tracking-[0.28em] text-ink-100/65 uppercase">
                <span data-i18n="about.now_showing">Now showing</span><span>N° {filmNumber(latest.bvid)}</span>
              </span>
              <span class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-4">
                <span>
                  <span class="rule-grow mb-2.5"></span>
                  <span class="block font-display italic text-2xl text-ink-100 leading-tight" data-i18n-self={JSON.stringify(latest.title)}>{latest.title.en}</span>
                </span>
                <span class="play-dot h-10 w-10 shrink-0"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg></span>
              </span>
            </span>
          </button>
          <div class="mt-3 grid grid-cols-3 gap-3">
            {frames.map((p, i) => (
              <a href="#photography" class="group block">
                <span class="relative block aspect-square overflow-hidden rounded-xl ring-1 ring-white/10">
                  <img src={p.thumb ?? p.src} alt={p.caption ?? p.location.name} loading="lazy" decoding="async" class="media-img absolute inset-0 w-full h-full object-cover" />
                  <span class="grain"></span>
                  <span class="absolute left-2 top-1.5 font-mono text-[9px] tracking-[0.2em] text-ink-100/70">{String(i + 1).padStart(2, '0')}A</span>
                </span>
                <span class="meta-line mt-2 !text-[9px] !flex-nowrap"><span class="truncate">{p.location.country}</span></span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="space-y-6 text-ink-300 leading-relaxed reveal">
        <p data-i18n="about.p1">
          I've just graduated with an MSc in Urban Environmental Management from
          Wageningen (end of May 2026). My thesis, on how microplastics move through
          catchments, sits at the intersection of water systems, global change, and urban
          sustainability.
        </p>
        <p data-i18n="about.p2">
          Before Wageningen, I studied forestry across Canada and China and interned with the
          University of Eastern Finland doing soil-water fieldwork in Lapland. I've been lucky to
          learn in four very different landscapes, and I carry a camera to each of them.
        </p>
        <p data-i18n="about.p3">
          This site is a working notebook: my research, the places I've stood in, and the photographs I've made there.
        </p>

        <div class="pt-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
          {
            skills.map((s) => (
              <div class="glass-soft rounded-xl p-3 text-center card-hover group">
                <div class="text-2xl group-hover:scale-110 transition-transform">{s.icon}</div>
                <div class="mt-1.5 text-[11px] uppercase tracking-[0.15em] text-ink-300" data-i18n={s.key}>{s.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
