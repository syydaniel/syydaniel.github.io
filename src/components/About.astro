---
import { profile } from '../data/profile';
import { films, filmLabel } from '../data/films';

// Newest featured film.
const latest = films.find((f) => f.featured)!;

// Line icons drawn to one 24px grid, so the tiles read as a set.
const ICON: Record<string, string> = {
  water: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>',
  microplastics: '<circle cx="7" cy="7" r="2.6"/><circle cx="17" cy="9" r="2.2"/><circle cx="10" cy="17" r="2.4"/><path d="M9.3 8.4l5.5 0.1M8.2 9.4l1.2 5.2M15.5 10.9l-3.6 4.4"/>',
  scenario: '<path d="M3 19h18"/><path d="M4 15l4.5-5 3.5 3 4-6 4 4"/><circle cx="20" cy="11" r="1"/>',
  climate: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>',
  ml: '<rect x="6" y="6" width="12" height="12" rx="2.5"/><path d="M9 9h6v6H9zM12 2v4M12 18v4M2 12h4M18 12h4M5 5l2 2M17 17l2 2M19 5l-2 2M5 19l2-2"/>',
  gis: '<path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14M15 6v14"/><circle cx="12" cy="11" r="1.5"/>',
  boreal: '<path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4v4h-4"/><path d="M4 12a8 8 0 0 0 2.3 5.7"/><path d="M4 20v-4h4"/>',
  urban: '<path d="M12 21V11"/><path d="M12 11c0-3 2.5-5 5-5-0 3-2.5 5-5 5zM12 15c0-3-2.5-5-5-5 0 3 2.5 5 5 5z"/><path d="M4 21h16"/>'
};
const skills = [
  { label: 'Water Quality', icon: 'water', key: 'about.skill.water' },
  { label: 'Microplastics', icon: 'microplastics', key: 'about.skill.microplastics' },
  { label: 'Environmental Modelling', icon: 'scenario', key: 'about.skill.scenario' },
  { label: 'Climate Change', icon: 'climate', key: 'about.skill.climate' },
  { label: 'Machine Learning', icon: 'ml', key: 'about.skill.ml' },
  { label: 'GIS Analysis', icon: 'gis', key: 'about.skill.gis' },
  { label: 'Carbon & Nutrient Cycles', icon: 'boreal', key: 'about.skill.boreal' },
  { label: 'Soils & Agriculture', icon: 'urban', key: 'about.skill.urban' }
];
---

<section id="about" class="relative py-28 md:py-40 scroll-mt-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-[1fr_1.1fr] gap-16 items-start">
      <div class="reveal">
        <span class="section-eyebrow" data-chapter="01" data-i18n="about.eyebrow">About me</span>
        <h2 class="section-title mt-4">
          <span data-i18n="about.title.a">Researching the</span>
          <span class="text-gradient italic font-display" data-i18n="about.title.b">quiet systems</span>
          <span data-i18n="about.title.c">we take for granted.</span>
        </h2>

        <!-- Now showing: the latest film, then recent frames -->
        <div class="mt-12 hidden lg:block">
          <button type="button" class="group relative block w-full overflow-hidden rounded-2xl ring-1 ring-white/10 card-hover text-left" data-film={latest.bvid} aria-label={`Play: ${latest.title.en}`}>
            <span class="relative block aspect-[2.2/1]">
              <img src={latest.featured!.stillSm} alt="" loading="lazy" decoding="async" class="media-img absolute inset-0 w-full h-full object-cover" style={`object-position:${latest.featured!.focus ?? '50% 50%'}`} />
              <span class="absolute inset-0 bg-gradient-to-t from-ink-950/90 via-ink-950/20 to-ink-950/30"></span>
              <span class="grain"></span>
              <span class="absolute inset-x-4 top-3 flex justify-between font-mono text-[9px] tracking-[0.28em] text-ink-100/65 uppercase">
                <span data-i18n="about.now_showing">Now showing</span><span data-i18n-self={JSON.stringify(filmLabel(latest.bvid))}>{filmLabel(latest.bvid).en}</span>
              </span>
              <span class="absolute inset-x-4 bottom-4 flex items-end justify-between gap-4">
                <span>
                  <span class="rule-grow mb-2.5"></span>
                  <span class="block font-display italic text-2xl text-ink-100 leading-tight" data-i18n-self={JSON.stringify(latest.title)}>{latest.title.en}</span>
                </span>
                <span class="play-dot h-10 w-10 shrink-0"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg></span>
              </span>
            </span>
          </button>
        </div>
      </div>

      <div class="space-y-6 text-ink-300 leading-relaxed reveal">
        <p data-i18n="about.p1">
          I graduated with an MSc in Urban Environmental Management from Wageningen in May 2026 and I'm now looking
          for a PhD position. My thesis estimated how much microplastic rivers retain, sub-basin by sub-basin
          worldwide, with machine learning benchmarked against the MARINA-Multi model.
        </p>
        <p data-i18n="about.p2">
          Before Wageningen, I studied forestry in China and Canada, where my first lab work was on soil microbes, and
          I monitored dissolved organic carbon in the wetland forests of Lapland with the University of Eastern
          Finland. I've been lucky to learn in four very different landscapes, and I carry a camera to each of them.
        </p>
        <p class="text-ink-200" data-i18n="about.next">
          Where I want to go next is the land side of global change: how farming practices shape soil health and
          the services soils provide, and how agriculture's non-CO₂ greenhouse gases, nitrous oxide and methane, can
          be quantified, modelled and reduced, from single fields up to the scale of Europe.
        </p>
        <p data-i18n="about.p3">
          This site is a working notebook: my research, the places I've stood in, and the photographs I've made there.
        </p>

        <ul class="skill-line" aria-label="Fields">
          {
            skills.map((s) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON[s.icon]} />
                <span data-i18n={s.key}>{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
