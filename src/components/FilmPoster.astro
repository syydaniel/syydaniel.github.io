---
// A film as a poster: the Bilibili cover blurred into a colour field (its baked-in
// text and faces dissolve) under the film's number, place, short title and runtime.
// Clicking opens the site-wide player (FilmPlayer.astro).
import { filmByBvid, filmLabel, coverThumb } from '../data/films';

interface Props {
  bvid: string;
  /** 'md' for the Films archive, 'sm' for inline use (Journey, About, Places). */
  size?: 'md' | 'sm';
  /** Show the full title and date below the poster. */
  caption?: boolean;
  class?: string;
}
const { bvid, size = 'md', caption = false, class: className = '' } = Astro.props;
const f = filmByBvid(bvid)!;
const short = f.poster ?? f.title;
const sm = size === 'sm';
---

<button type="button" class:list={['film-open group block w-full text-left', className]} data-film={f.bvid} aria-label={`Play: ${f.title.en}`}>
  <span class="relative block aspect-[4/5] overflow-hidden rounded-2xl bg-ink-900 ring-1 ring-white/10 transition-shadow duration-500 group-hover:ring-sol-400/30">
    <img
      src={coverThumb(f.cover, sm ? 320 : 640, sm ? 180 : 360)}
      alt=""
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      class="poster-wash absolute inset-0 w-full h-full object-cover"
    />
    <span class="poster-shade absolute inset-0" aria-hidden="true"></span>
    <span class="grain" aria-hidden="true"></span>

    <span class:list={['absolute flex items-center justify-between font-mono uppercase tracking-[0.28em] text-ink-100/65', sm ? 'inset-x-3 top-3 text-[9px]' : 'inset-x-3 sm:inset-x-4 top-3 sm:top-4 text-[9px] sm:text-[10px]']}>
      <span data-i18n-self={JSON.stringify(filmLabel(f.bvid))}>{filmLabel(f.bvid).en}</span>
      <span>{f.date.slice(0, 4)}</span>
    </span>

    <span class:list={['absolute flex flex-col', sm ? 'inset-x-3 bottom-3' : 'inset-x-3 sm:inset-x-4 bottom-3 sm:bottom-4']}>
      <span class="rule-grow mb-3" aria-hidden="true"></span>
      {f.place && !sm && (
        <span class="mb-2 text-[10px] font-mono uppercase tracking-[0.28em] text-sol-400/90 truncate" data-i18n-self={JSON.stringify(f.place)}>
          {f.place.en}
        </span>
      )}
      <span
        class:list={['poster-title font-display italic text-ink-100 leading-[1.05]', sm ? 'text-[1.05rem] lg:text-[1.15rem]' : 'text-[1.3rem] sm:text-[1.75rem]']}
        data-i18n-self={JSON.stringify(short)}
      >
        {short.en}
      </span>
      <span class:list={['flex items-center justify-between', sm ? 'mt-3' : 'mt-4']}>
        <span class="font-mono text-[11px] text-ink-100/75">{f.duration}</span>
        <span class:list={['play-dot', sm ? 'h-7 w-7' : 'h-9 w-9']} aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg>
        </span>
      </span>
    </span>
  </span>
  {
    caption && (
      <Fragment>
        <span class="mt-3 block text-[0.9rem] leading-snug text-ink-300 group-hover:text-ink-100 transition-colors line-clamp-2" data-i18n-self={JSON.stringify(f.title)}>
          {f.title.en}
        </span>
        <span class="meta-line mt-1.5">{f.date.replaceAll('-', '.')}</span>
      </Fragment>
    )
  }
</button>

<style>
  .poster-wash {
    transform: scale(1.45);
    filter: blur(22px) saturate(1.5) brightness(0.7);
    transition: transform 1.2s var(--ease-film), filter 0.8s ease;
  }
  .group:hover .poster-wash,
  .group:focus-visible .poster-wash {
    transform: scale(1.6);
    filter: blur(18px) saturate(1.7) brightness(0.78);
  }
  .poster-shade {
    background:
      radial-gradient(120% 70% at 20% 0%, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 60%),
      linear-gradient(to top, rgba(5, 6, 10, 0.82) 0%, rgba(5, 6, 10, 0.25) 55%, rgba(5, 6, 10, 0.35) 100%);
  }
  .poster-title { text-wrap: balance; letter-spacing: -0.01em; }
  @media (prefers-reduced-motion: reduce) {
    .poster-wash { transition: none; }
  }
</style>
